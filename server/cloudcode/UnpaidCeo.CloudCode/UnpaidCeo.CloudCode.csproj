<Project Sdk="Microsoft.NET.Sdk">
  <!-- Cloud Code C# module "UnpaidCeo": validates runs with the game's own core (compiled from the Unity sources). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>UnpaidCeo</AssemblyName>
    <RootNamespace>UnpaidCeo.CloudCode</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS8632;CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../game/Assets/UnpaidCeo/Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../../game/Assets/UnpaidCeo/Content/*.json" LogicalName="content/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Com.Unity.Services.CloudCode.Core" Version="0.0.9" />
    <PackageReference Include="Com.Unity.Services.CloudCode.Apis" Version="0.0.27" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
