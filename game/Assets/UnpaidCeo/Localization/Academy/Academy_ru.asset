  - m_Id: 468705331
    m_Localized: "\u041A\u0430\u0441\u0441\u043E\u0432\u044B\u0439 \u0440\u0430\u0437\u0440\u044B\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 468705332
    m_Localized: "\u0418\u043D\u0444\u043B\u044F\u0446\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 468705333
    m_Localized: "\u0427\u0442\u043E \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043A\u0430\u0441\u0441\u043E\u0432\u044B\u0439 \u0440\u0430\u0437\u0440\u044B\u0432 \u0431\u0435\u0437 \u043D\u043E\u0432\u043E\u0433\u043E \u0434\u043E\u043B\u0433\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 468705334
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432 \u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0431\u044B\u0441\u0442\u0440\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 468705335
    m_Localized: "\u0417\u0430\u0451\u043C \u0443 \u043C\u0438\u0441\u0442\u0435\u0440\u0430 \u0424\u0438\u043D\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 468705336
    m_Localized: "\u0417\u0430\u043A\u0443\u043F\u0438\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435 \u0442\u043E\u0432\u0430\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 468705337
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0440\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A \u2014 \u0445\u0443\u0434\u0448\u0438\u0439 \u0441\u043F\u043E\u0441\u043E\u0431 \u0437\u0430\u043A\u0440\u044B\u0442\u044C \u0440\u0430\u0437\u0440\u044B\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 468705338
    m_Localized: "\u042D\u0442\u043E \u0434\u043E\u043B\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 468705339
    m_Localized: "\u041E\u043D \u0434\u0430\u0451\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435 \u0441\u0443\u043C\u043C\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 468705340
    m_Localized: "\u041F\u0440\u043E\u0446\u0435\u043D\u0442\u044B \u0434\u0435\u043B\u0430\u044E\u0442 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0440\u0430\u0437\u0440\u044B\u0432 \u0431\u043E\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 468705341
    m_Localized: "\u0422\u043E\u0447\u043A\u0430 \u0431\u0435\u0437\u0443\u0431\u044B\u0442\u043E\u0447\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 468705342
    m_Localized: "\u0422\u043E\u0447\u043A\u0430 \u0431\u0435\u0437\u0443\u0431\u044B\u0442\u043E\u0447\u043D\u043E\u0441\u0442\u0438 \u2014 \u044D\u0442\u043E \u0447\u0438\u0441\u043B\u043E \u043F\u0440\u043E\u0434\u0430\u0436, \u043F\u043E\u0441\u043B\u0435 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0442\u044B \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0451\u0448\u044C \u0442\u0435\u0440\u044F\u0442\u044C \u0434\u0435\u043D\u044C\u0433\u0438. \u0424\u043E\u0440\u043C\u0443\u043B\u0430: \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0435 \u0440\u0430\u0441\u0445\u043E\u0434\u044B \u0434\u0435\u043B\u0438\u0442\u044C \u043D\u0430 \u0442\u043E, \u0447\u0442\u043E \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043A\u0430\u0436\u0434\u0430\u044F \u043F\u0440\u043E\u0434\u0430\u0436\u0430 \u043F\u043E\u0441\u043B\u0435 \u0441\u0432\u043E\u0435\u0439 \u0441\u0435\u0431\u0435\u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u0438. \u0414\u043E\u043F\u0443\u0441\u0442\u0438\u043C, \u0444\u0443\u0434\u0442\u0440\u0430\u043A \u043F\u043B\u0430\u0442\u0438\u0442 3\_000\_$ \u0432 \u043C\u0435\u0441\u044F\u0446 \u0437\u0430 \u0441\u0442\u043E\u044F\u043D\u043A\u0443, \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u043A\u0443 \u0438 \u043A\u0440\u0435\u0434\u0438\u0442. \u041E\u0431\u0435\u0434 \u0441\u0442\u043E\u0438\u0442 12\_$, \u0430 \u0435\u0433\u043E \u0441\u0435\u0431\u0435\u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u2014 4\_$, \u0437\u043D\u0430\u0447\u0438\u0442, \u043E\u043D \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 8\_$. 3\_000 \u0434\u0435\u043B\u0438\u0442\u044C \u043D\u0430 8 \u2014 \u044D\u0442\u043E 375 \u043E\u0431\u0435\u0434\u043E\u0432 \u0432 \u043C\u0435\u0441\u044F\u0446. \u041E\u0431\u0435\u0434 \u043D\u043E\u043C\u0435\u0440 376 \u2014 \u043F\u0435\u0440\u0432\u044B\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442 \u043F\u0440\u0438\u0431\u044B\u043B\u044C. \u0412 \u0411\u0440\u0443\u043A\u043B\u0438\u043D\u0435 \u0431\u0443\u0434\u0443\u0442 \u0430\u0440\u0435\u043D\u0434\u0430 \u0438 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0438, \u0442\u0430\u043A \u0447\u0442\u043E \u0437\u043D\u0430\u0439 \u0441\u0432\u043E\u044E \u0442\u043E\u0447\u043A\u0443 \u0431\u0435\u0437\u0443\u0431\u044B\u0442\u043E\u0447\u043D\u043E\u0441\u0442\u0438 \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u0447\u0442\u043E-\u0442\u043E \u043F\u043E\u0434\u043F\u0438\u0441\u044B\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 468705343
    m_Localized: "\u041F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0435 \u0440\u0430\u0441\u0445\u043E\u0434\u044B \u2014 2\_000\_$ \u0432 \u043C\u0435\u0441\u044F\u0446. \u041A\u0430\u0436\u0434\u0430\u044F \u043F\u0440\u043E\u0434\u0430\u0436\u0430 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 10\_$ \u043F\u043E\u0441\u043B\u0435 \u0441\u0435\u0431\u0435\u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u0438. \u0413\u0434\u0435 \u0442\u043E\u0447\u043A\u0430 \u0431\u0435\u0437\u0443\u0431\u044B\u0442\u043E\u0447\u043D\u043E\u0441\u0442\u0438?"
