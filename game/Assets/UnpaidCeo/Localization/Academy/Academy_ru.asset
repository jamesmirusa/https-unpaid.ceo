  - m_Id: 90748379717714
    m_Localized: "\u041E\u043A\u043E\u043B\u043E 3 300\u20133 900 $ \u0441 \u0440\u0430\u0441\u0445\u043E\u0434\u0430\u043C\u0438 \u0440\u0430\u0431\u043E\u0442\u043E\u0434\u0430\u0442\u0435\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717715
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u043A\u043B\u0438\u0435\u043D\u0442\u044B \u043F\u043B\u0430\u0442\u044F\u0442 \u043F\u043E\u0437\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717716
    m_Localized: "\u0411\u0438\u0437\u043D\u0435\u0441-\u043A\u043B\u0438\u0435\u043D\u0442\u044B \u0440\u0435\u0434\u043A\u043E \u043F\u043B\u0430\u0442\u044F\u0442 \u0441\u0440\u0430\u0437\u0443. \u0421\u043A\u043B\u0430\u0434, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043D\u0430\u043D\u0438\u043C\u0430\u0435\u0442 \u0442\u0432\u043E\u0439 \u0433\u0440\u0443\u0437\u043E\u0432\u0438\u043A, \u043C\u043E\u0436\u0435\u0442 \u043F\u043B\u0430\u0442\u0438\u0442\u044C \xABnet 30\xBB \u0438\u043B\u0438 \xABnet 60\xBB \u2014 \u0447\u0435\u0440\u0435\u0437 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u0438\u043B\u0438 \u0448\u0435\u0441\u0442\u044C\u0434\u0435\u0441\u044F\u0442 \u0434\u043D\u0435\u0439 \u043F\u043E\u0441\u043B\u0435 \u0441\u0447\u0451\u0442\u0430. \u0410 \u0442\u043E\u043F\u043B\u0438\u0432\u043E, \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u043A\u0430 \u0438 \u0437\u0430\u0440\u043F\u043B\u0430\u0442\u0430 \u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044F \u0443\u0445\u043E\u0434\u044F\u0442 \u043A\u0430\u0436\u0434\u0443\u044E \u043D\u0435\u0434\u0435\u043B\u044E. \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u0431\u044B\u0441\u0442\u0440\u043E \u0440\u0430\u0441\u0442\u0443\u0449\u0438\u0439 B2B-\u0431\u0438\u0437\u043D\u0435\u0441 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u043F\u0440\u0438\u0431\u044B\u043B\u044C\u043D\u044B\u043C \u043D\u0430 \u0431\u0443\u043C\u0430\u0433\u0435 \u0438 \u043F\u0443\u0441\u0442\u044B\u043C \u0432 \u0431\u0430\u043D\u043A\u0435: \u0447\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u0437\u0430\u043A\u0430\u0437\u043E\u0432 \u0442\u044B \u0431\u0435\u0440\u0451\u0448\u044C, \u0442\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u0434\u0435\u043D\u0435\u0433 \u0437\u0430\u0441\u0442\u0440\u0435\u0432\u0430\u0435\u0442 \u0432 \u043D\u0435\u043E\u043F\u043B\u0430\u0447\u0435\u043D\u043D\u044B\u0445 \u0441\u0447\u0435\u0442\u0430\u0445 \u2014 \u0434\u0435\u0431\u0438\u0442\u043E\u0440\u0441\u043A\u043E\u0439 \u0437\u0430\u0434\u043E\u043B\u0436\u0435\u043D\u043D\u043E\u0441\u0442\u0438. \u0427\u0442\u043E \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0440\u0430\u0437\u0440\u044B\u0432: \u0432\u044B\u0441\u0442\u0430\u0432\u043B\u044F\u0439 \u0441\u0447\u0451\u0442 \u0432 \u0434\u0435\u043D\u044C \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u0440\u0430\u0431\u043E\u0442\u044B, \u043F\u0440\u043E\u0441\u0438 \u043F\u0440\u0435\u0434\u043E\u043F\u043B\u0430\u0442\u0443, \u0434\u0430\u0432\u0430\u0439 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0443\u044E \u0441\u043A\u0438\u0434\u043A\u0443 \u0437\u0430 \u043E\u043F\u043B\u0430\u0442\u0443 \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 10 \u0434\u043D\u0435\u0439, \u0434\u0435\u0440\u0436\u0438 \u0440\u0435\u0437\u0435\u0440\u0432 \u043D\u0430 \u043E\u0434\u0438\u043D-\u0434\u0432\u0430 \u043C\u0435\u0441\u044F\u0446\u0430 \u0440\u0430\u0441\u0445\u043E\u0434\u043E\u0432 \u0438\u043B\u0438 \u043E\u0442\u043A\u0440\u043E\u0439 \u0431\u0438\u0437\u043D\u0435\u0441-\u043A\u0440\u0435\u0434\u0438\u0442\u043D\u0443\u044E \u043B\u0438\u043D\u0438\u044E. \u041D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0439 \u0440\u0430\u0437\u0440\u044B\u0432 \u0437\u0430\u0439\u043C\u043E\u043C \u0443 \u0440\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
