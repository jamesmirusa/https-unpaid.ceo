  - m_Id: 90748379717743
    m_Localized: "\u041A\u0430\u043A \u0431\u0440\u0430\u0442\u044C \u043A\u0440\u0435\u0434\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717744
    m_Localized: "\u041A\u0440\u0435\u0434\u0438\u0442 \u2014 \u044D\u0442\u043E \u043F\u043E\u043A\u0443\u043F\u043A\u0430 \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0437\u0430 \u0434\u0435\u043D\u044C\u0433\u0438: \u0434\u0435\u043D\u044C\u0433\u0438 \u0441\u0435\u0439\u0447\u0430\u0441, \u0430 \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435 \u043F\u043E\u0442\u043E\u043C. \u0426\u0435\u043D\u0430 \u2014 \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043D\u0430\u044F \u0441\u0442\u0430\u0432\u043A\u0430, \u0433\u043E\u0434\u043E\u0432\u0430\u044F, APR. \u041F\u043E\u0434 12% \u0433\u043E\u0434\u043E\u0432\u044B\u0445 10 000 $ \u0441\u0442\u043E\u044F\u0442 \u043F\u043E\u043D\u0430\u0447\u0430\u043B\u0443 \u043E\u043A\u043E\u043B\u043E 100 $ \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432 \u0432 \u043C\u0435\u0441\u044F\u0446 \u0438 \u043C\u0435\u043D\u044C\u0448\u0435 \u043F\u043E \u043C\u0435\u0440\u0435 \u043F\u043E\u0433\u0430\u0448\u0435\u043D\u0438\u044F. \u0411\u0430\u043D\u043A\u0438 \u0441\u043C\u043E\u0442\u0440\u044F\u0442 \u043D\u0430 \u043A\u0440\u0435\u0434\u0438\u0442\u043D\u0443\u044E \u0438\u0441\u0442\u043E\u0440\u0438\u044E, \u0434\u0435\u043D\u0435\u0436\u043D\u044B\u0439 \u043F\u043E\u0442\u043E\u043A \u0438 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044E: \u0447\u0435\u043C \u043E\u043D\u0430 \u0441\u043B\u0430\u0431\u0435\u0435, \u0442\u0435\u043C \u0432\u044B\u0448\u0435 \u0441\u0442\u0430\u0432\u043A\u0430. \u0412 \u0421\u0428\u0410 \u0410\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044F \u043C\u0430\u043B\u043E\u0433\u043E \u0431\u0438\u0437\u043D\u0435\u0441\u0430 (SBA) \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0440\u0443\u0435\u0442 \u043A\u0440\u0435\u0434\u0438\u0442\u044B \u0431\u0430\u043D\u043A\u043E\u0432 \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u043A\u0440\u0435\u0434\u0438\u0442\u043E\u0440\u043E\u0432: \u043C\u0438\u043A\u0440\u043E\u043A\u0440\u0435\u0434\u0438\u0442\u044B SBA \u2014 \u0434\u043E 50 000 $, \u043A\u0440\u0435\u0434\u0438\u0442\u044B 7(a) \u2014 \u0434\u043E 5 \u043C\u0438\u043B\u043B\u0438\u043E\u043D\u043E\u0432 $, \u0430 \u0441\u0442\u0430\u0432\u043A\u0438 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u044B \u0435\u0451 \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u043C\u0438. \u0411\u0435\u0440\u0438 \u0432 \u0434\u043E\u043B\u0433 \u043D\u0430 \u0442\u043E, \u0447\u0442\u043E \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442, \u2014 \u0432\u0442\u043E\u0440\u0443\u044E \u0442\u0435\u043B\u0435\u0436\u043A\u0443 \u0438\u043B\u0438 \u0433\u0440\u0443\u0437\u043E\u0432\u0438\u043A, \u2014 \u0430 \u043D\u0435 \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u043A\u0440\u044B\u0442\u044C \u0443\u0431\u044B\u0442\u043A\u0438, \u043F\u0440\u0438\u0447\u0438\u043D\u044B \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C. \u041F\u043B\u0430\u0442\u0451\u0436 \u043D\u0443\u0436\u043D\u043E \u0432\u043D\u043E\u0441\u0438\u0442\u044C, \u0431\u0443\u0434\u0443\u0442 \u043F\u0440\u043E\u0434\u0430\u0436\u0438 \u0438\u043B\u0438 \u043D\u0435\u0442, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0439 \u0435\u0433\u043E \u043D\u0430 \u0441\u0432\u043E\u0451\u043C \u0445\u0443\u0434\u0448\u0435\u043C \u043C\u0435\u0441\u044F\u0446\u0435, \u0430 \u043D\u0435 \u043D\u0430 \u043B\u0443\u0447\u0448\u0435\u043C."
    m_Metadata:
      m_Items: []
