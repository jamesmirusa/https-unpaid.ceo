  - m_Id: 468705354
    m_Localized: "\u0440\u0430\u0441\u0442\u0451\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 90748367134720
    m_Localized: "\u042E\u043D\u0438\u0442-\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717632
    m_Localized: "\u041F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u044C \u043F\u0435\u0440\u0432\u0443\u044E \u0442\u0435\u043B\u0435\u0436\u043A\u0443, \u0444\u0443\u0440\u0433\u043E\u043D \u0438\u043B\u0438 \u0433\u0440\u0443\u0437\u043E\u0432\u0438\u043A, \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u043D\u0430 \u043E\u0434\u043D\u0443 \u043F\u0440\u043E\u0434\u0430\u0436\u0443. \u041A\u043E\u0444\u0435\u0439\u043D\u0430\u044F \u0442\u0435\u043B\u0435\u0436\u043A\u0430 \u043F\u0440\u043E\u0434\u0430\u0451\u0442 \u0447\u0430\u0448\u043A\u0443 \u0437\u0430 4 $, \u0430 \u043C\u043E\u043B\u043E\u043A\u043E, \u0437\u0451\u0440\u043D\u0430 \u0438 \u0441\u0442\u0430\u043A\u0430\u043D\u0447\u0438\u043A \u0441\u0442\u043E\u044F\u0442 1,20 $. \u041E\u0441\u0442\u0430\u0451\u0442\u0441\u044F 2,80 $ \u2014 \u044D\u0442\u043E \u0432\u0430\u043B\u043E\u0432\u0430\u044F \u043C\u0430\u0440\u0436\u0430 70%. \u041F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0435 \u0440\u0430\u0441\u0445\u043E\u0434\u044B \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442 \u043A\u0430\u0436\u0434\u044B\u0439 \u043C\u0435\u0441\u044F\u0446, \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u043D\u0438\u043A\u0442\u043E \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043A\u0443\u043F\u0438\u043B: 1 200 $ \u0437\u0430 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435, \u0441\u0442\u043E\u044F\u043D\u043A\u0443 \u0438 \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u043A\u0443 \u043F\u043E\u043A\u0440\u043E\u044E\u0442 \u0442\u043E\u043B\u044C\u043A\u043E 429 \u0447\u0430\u0448\u0435\u043A. \u042D\u0442\u043E \u0442\u0432\u043E\u044F \u0442\u043E\u0447\u043A\u0430 \u0431\u0435\u0437\u0443\u0431\u044B\u0442\u043E\u0447\u043D\u043E\u0441\u0442\u0438. \u042E\u043D\u0438\u0442-\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0430 \u0437\u0430\u0434\u0430\u0451\u0442 \u0442\u0440\u0438 \u0432\u043E\u043F\u0440\u043E\u0441\u0430. \u0421\u043A\u043E\u043B\u044C\u043A\u043E \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u0434\u043D\u0430 \u043F\u0440\u043E\u0434\u0430\u0436\u0430? \u0421\u043A\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u043E\u0434\u0430\u0436 \u043F\u043E\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u043C\u0435\u0441\u044F\u0446? \u0421\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u0442\u043E\u0438\u0442 \u043F\u0440\u0438\u0432\u043B\u0435\u0447\u044C \u043A\u043B\u0438\u0435\u043D\u0442\u0430 \u0438 \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043E\u043D \u043F\u0440\u0438\u043D\u0435\u0441\u0451\u0442 \u0437\u0430 \u0432\u0441\u0451 \u0432\u0440\u0435\u043C\u044F? \u0415\u0441\u043B\u0438 \u043E\u0434\u043D\u0430 \u043F\u0440\u043E\u0434\u0430\u0436\u0430 \u0443\u0431\u044B\u0442\u043E\u0447\u043D\u0430, \u0440\u043E\u0441\u0442 \u043F\u0440\u043E\u0434\u0430\u0436 \u0442\u043E\u043B\u044C\u043A\u043E \u0443\u0441\u043A\u043E\u0440\u044F\u0435\u0442 \u0443\u0431\u044B\u0442\u043A\u0438. \u042D\u043A\u0440\u0430\u043D \xAB\u041A\u043E\u043C\u043F\u0430\u043D\u0438\u044F\xBB \u043A\u0430\u0436\u0434\u044B\u0439 \u043C\u0435\u0441\u044F\u0446 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u044D\u0442\u0438 \u0446\u0438\u0444\u0440\u044B \u0434\u043B\u044F \u0442\u0432\u043E\u0435\u0433\u043E \u0431\u0438\u0437\u043D\u0435\u0441\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717633
    m_Localized: "\u0427\u0430\u0448\u043A\u0430 \u0441\u0442\u043E\u0438\u0442 4 $, \u0430 \u0435\u0451 \u0441\u0435\u0431\u0435\u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u2014 1,20 $. \u041A\u0430\u043A\u0430\u044F \u0432\u0430\u043B\u043E\u0432\u0430\u044F \u043C\u0430\u0440\u0436\u0430?"
