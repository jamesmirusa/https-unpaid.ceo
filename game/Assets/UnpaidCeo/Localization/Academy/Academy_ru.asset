    m_Localized: "\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435 \u0441\u0442\u043E\u0438\u0442 \u0437\u0430\u0440\u043F\u043B\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717702
    m_Localized: "\u0421\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A \u0441 \u0437\u0430\u0440\u043F\u043B\u0430\u0442\u043E\u0439 3 000 $ \u0432 \u043C\u0435\u0441\u044F\u0446 \u043E\u0431\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0434\u043E\u0440\u043E\u0436\u0435 3 000 $. \u0421\u0432\u0435\u0440\u0445 \u0437\u0430\u0440\u043F\u043B\u0430\u0442\u044B \u0440\u0430\u0431\u043E\u0442\u043E\u0434\u0430\u0442\u0435\u043B\u044C \u043F\u043B\u0430\u0442\u0438\u0442 7,65% \u043D\u0430 \u0441\u043E\u0446\u0441\u0442\u0440\u0430\u0445\u043E\u0432\u0430\u043D\u0438\u0435 \u0438 \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0443, \u0430 \u0435\u0449\u0451 \u0444\u0435\u0434\u0435\u0440\u0430\u043B\u044C\u043D\u043E\u0435 \u0438 \u0448\u0442\u0430\u0442\u043D\u043E\u0435 \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u0430\u043D\u0438\u0435 \u043E\u0442 \u0431\u0435\u0437\u0440\u0430\u0431\u043E\u0442\u0438\u0446\u044B, \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u043A\u0438 \u043E\u0442 \u043D\u0435\u0441\u0447\u0430\u0441\u0442\u043D\u044B\u0445 \u0441\u043B\u0443\u0447\u0430\u0435\u0432 \u0438 \u043F\u043E \u043D\u0435\u0442\u0440\u0443\u0434\u043E\u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438. \u041C\u043D\u043E\u0433\u0438\u0435 \u043C\u0430\u043B\u044B\u0435 \u0431\u0438\u0437\u043D\u0435\u0441\u044B \u0437\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E\u0442 \u043D\u0430 \u0432\u0441\u0451 \u044D\u0442\u043E 10\u201330% \u0441\u0432\u0435\u0440\u0445 \u0437\u0430\u0440\u043F\u043B\u0430\u0442. \u0418 \u0443 \u0437\u0430\u0440\u043F\u043B\u0430\u0442\u044B \u0441\u0432\u043E\u0439 \u0433\u0440\u0430\u0444\u0438\u043A, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043D\u0435\u0442 \u0443 \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432: \u043E\u043D\u0430 \u0443\u0445\u043E\u0434\u0438\u0442 \u0432 \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0434\u0435\u043D\u044C, \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u043A\u043B\u0438\u0435\u043D\u0442\u044B \u043F\u043B\u0430\u0442\u044F\u0442 \u0441 \u043E\u043F\u043E\u0437\u0434\u0430\u043D\u0438\u0435\u043C. \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u0438\u043C\u0435\u043D\u043D\u043E \u0437\u0430\u0440\u043F\u043B\u0430\u0442\u044B \u0447\u0430\u0449\u0435 \u0432\u0441\u0435\u0433\u043E \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u044E\u0442 \u043F\u0440\u0438\u0431\u044B\u043B\u044C\u043D\u044B\u0439 \u043C\u0435\u0441\u044F\u0446 \u0432 \u043F\u0443\u0441\u0442\u043E\u0439 \u0441\u0447\u0451\u0442. \u0412 \u0438\u0433\u0440\u0435 \u043A\u0430\u0436\u0434\u044B\u0439 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442 \u043A \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u043C \u0440\u0430\u0441\u0445\u043E\u0434\u0430\u043C \u0437\u0430\u0440\u043F\u043B\u0430\u0442\u0443 \u0438 \u0435\u0449\u0451 10% \u0441\u0432\u0435\u0440\u0445\u0443. \u041F\u0435\u0440\u0435\u0434 \u043D\u0430\u0439\u043C\u043E\u043C \u043F\u0440\u043E\u0432\u0435\u0440\u044C, \u0447\u0442\u043E \u0432\u0430\u043B\u043E\u0432\u0430\u044F \u043F\u0440\u0438\u0431\u044B\u043B\u044C \u043F\u043E\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043F\u043E\u043B\u043D\u0443\u044E \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430, \u0430 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0437\u0430\u0440\u043F\u043B\u0430\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717703
    m_Localized: "\u041A\u0430\u043A\u0443\u044E \u0434\u043E\u043B\u044E \u0441\u0432\u0435\u0440\u0445 \u0437\u0430\u0440\u043F\u043B\u0430\u0442\u044B \u0440\u0430\u0431\u043E\u0442\u043E\u0434\u0430\u0442\u0435\u043B\u044C \u043F\u043B\u0430\u0442\u0438\u0442 \u043D\u0430 \u0441\u043E\u0446\u0441\u0442\u0440\u0430\u0445\u043E\u0432\u0430\u043D\u0438\u0435 \u0438 \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0443?"
