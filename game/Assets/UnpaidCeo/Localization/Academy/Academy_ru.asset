  - m_Id: 90748379717708
    m_Localized: "\u0411\u0430\u043D\u043A\u0438 \u0431\u043B\u043E\u043A\u0438\u0440\u0443\u044E\u0442 \u0432\u044B\u043F\u043B\u0430\u0442\u0443 \u0437\u0430\u0440\u043F\u043B\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717709
    m_Localized: "\u0417\u0430\u0440\u043F\u043B\u0430\u0442\u0430 \u0443\u0445\u043E\u0434\u0438\u0442 \u0432 \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0434\u0435\u043D\u044C, \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u043A\u043B\u0438\u0435\u043D\u0442\u044B \u043F\u043B\u0430\u0442\u044F\u0442 \u0441 \u043E\u043F\u043E\u0437\u0434\u0430\u043D\u0438\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717710
    m_Localized: "\u0421\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430\u043C \u043C\u043E\u0436\u043D\u043E \u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u043B\u0438\u0447\u043D\u044B\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717711
    m_Localized: "\u0421\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 3 000 $ \u0432 \u043C\u0435\u0441\u044F\u0446. \u041A\u0430\u043A\u043E\u0439 \u043C\u0435\u0441\u044F\u0447\u043D\u044B\u0439 \u0431\u044E\u0434\u0436\u0435\u0442 \u0440\u0435\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u043D?"
