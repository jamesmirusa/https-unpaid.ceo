  - m_Id: 90748379717646
    m_Localized: "\u0426\u0435\u043D\u0430 \u2014 \u0441\u0430\u043C\u044B\u0439 \u0431\u044B\u0441\u0442\u0440\u044B\u0439 \u0440\u044B\u0447\u0430\u0433, \u0438 \u043E\u0448\u0438\u0431\u0438\u0442\u044C\u0441\u044F \u0441 \u043D\u0438\u043C \u043F\u0440\u043E\u0449\u0435 \u0432\u0441\u0435\u0433\u043E. \u041F\u043E\u0434\u043D\u0438\u043C\u0435\u0448\u044C \u2014 \u043A\u0430\u0436\u0434\u0430\u044F \u043F\u0440\u043E\u0434\u0430\u0436\u0430 \u043E\u0441\u0442\u0430\u0432\u0438\u0442 \u0431\u043E\u043B\u044C\u0448\u0435, \u043D\u043E \u0447\u0430\u0441\u0442\u044C \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432 \u0443\u0439\u0434\u0451\u0442. \u0421\u043D\u0438\u0437\u0438\u0448\u044C \u2014 \u043A\u0443\u043F\u044F\u0442 \u0431\u043E\u043B\u044C\u0448\u0435 \u043B\u044E\u0434\u0435\u0439, \u043D\u043E \u043A\u0430\u0436\u0434\u0430\u044F \u043F\u0440\u043E\u0434\u0430\u0436\u0430 \u043E\u0441\u0442\u0430\u0432\u0438\u0442 \u043C\u0435\u043D\u044C\u0448\u0435. \u041C\u0430\u0433\u0430\u0437\u0438\u043D \u0440\u0435\u0441\u0435\u0439\u043B\u0430 \u043F\u043E\u043A\u0443\u043F\u0430\u0435\u0442 \u043A\u0443\u0440\u0442\u043A\u0438 \u043F\u043E 15 $. \u041F\u043E 40 $ \u043E\u043D \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442 25 $ \u043D\u0430 \u043A\u0443\u0440\u0442\u043A\u0435, \u043F\u043E 30 $ \u2014 \u0442\u043E\u043B\u044C\u043A\u043E 15 $, \u0438 \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0436\u0435, \u043D\u0443\u0436\u043D\u043E \u043F\u0440\u043E\u0434\u0430\u0442\u044C \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E \u043D\u0430 \u0434\u0432\u0435 \u0442\u0440\u0435\u0442\u0438 \u0431\u043E\u043B\u044C\u0448\u0435. \u041D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u043F\u0440\u043E\u0441 \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u0435\u0442 \u043D\u0430 \u0446\u0435\u043D\u0443, \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u044D\u043B\u0430\u0441\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u044C\u044E. \u041A\u043E\u0444\u0435 \u0443 \u0432\u044B\u0445\u043E\u0434\u0430 \u0438\u0437 \u043C\u0435\u0442\u0440\u043E \u043F\u043E\u0447\u0442\u0438 \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u0442 \u043F\u043E\u0434\u043E\u0440\u043E\u0436\u0430\u043D\u0438\u044F \u043D\u0430 25 \u0446\u0435\u043D\u0442\u043E\u0432, \u0430 \u043A\u0443\u0440\u0442\u043A\u0443 \u0440\u044F\u0434\u043E\u043C \u0441 \u0431\u043E\u043B\u0435\u0435 \u0434\u0435\u0448\u0451\u0432\u044B\u043C \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043E\u043C \u2014 \u0437\u0430\u043C\u0435\u0442\u044F\u0442. \u041C\u0435\u043D\u044F\u0439 \u0446\u0435\u043D\u0443 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u043C\u0438 \u0448\u0430\u0433\u0430\u043C\u0438, \u0441\u043C\u043E\u0442\u0440\u0438 \u043F\u0440\u043E\u0434\u0430\u0436\u0438 \u0437\u0430 \u0446\u0435\u043B\u044B\u0439 \u043C\u0435\u0441\u044F\u0446 \u0438 \u043F\u043E\u043C\u043D\u0438: \u0441\u043A\u0438\u0434\u043A\u0443 \u043B\u0435\u0433\u043A\u043E \u0432\u0432\u0435\u0441\u0442\u0438 \u0438 \u0442\u0440\u0443\u0434\u043D\u043E \u043E\u0442\u043C\u0435\u043D\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717647
    m_Localized: "\u041A\u0443\u0440\u0442\u043A\u0430 \u043E\u0431\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0442\u0435\u0431\u0435 \u0432 15 $. \u041F\u043E 40 $ \u0442\u044B \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0448\u044C 25 $ \u0441 \u043A\u0443\u0440\u0442\u043A\u0438, \u043F\u043E 30 $ \u2014 15 $. \u041D\u0430 \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0431\u043E\u043B\u044C\u0448\u0435 \u043A\u0443\u0440\u0442\u043E\u043A \u043D\u0443\u0436\u043D\u043E \u043F\u0440\u043E\u0434\u0430\u0442\u044C \u043F\u043E 30 $, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0436\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717648
    m_Localized: "\u041F\u0440\u0438\u043C\u0435\u0440\u043D\u043E \u043D\u0430 \u0434\u0432\u0435 \u0442\u0440\u0435\u0442\u0438 \u0431\u043E\u043B\u044C\u0448\u0435"
