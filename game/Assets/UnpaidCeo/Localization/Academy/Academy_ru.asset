    m_Localized: "\u041D\u0430 10% \u0431\u043E\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717650
    m_Localized: "\u0421\u0442\u043E\u043B\u044C\u043A\u043E \u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717651
    m_Localized: "\u0427\u0442\u043E \u0438\u0437\u043C\u0435\u0440\u044F\u0435\u0442 \u044D\u043B\u0430\u0441\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717652
    m_Localized: "\u041A\u0430\u043A \u0431\u044B\u0441\u0442\u0440\u043E \u0446\u0435\u043D\u044B \u0440\u0430\u0441\u0442\u0443\u0442 \u043A\u0430\u0436\u0434\u044B\u0439 \u0433\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717653
    m_Localized: "\u041D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u0441\u043F\u0440\u043E\u0441 \u043F\u0440\u0438 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0438 \u0446\u0435\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717654
    m_Localized: "\u041D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0442\u044F\u043D\u0443\u0442\u0441\u044F \u0442\u0432\u043E\u0438 \u0442\u043E\u0432\u0430\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717655
    m_Localized: "\u041A\u0430\u043A \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0435\u0435 \u0432\u0441\u0435\u0433\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043D\u043E\u0432\u0443\u044E \u0446\u0435\u043D\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717656
    m_Localized: "\u0421\u043D\u0438\u0437\u0438\u0442\u044C \u0432\u0434\u0432\u043E\u0435 \u043D\u0430 \u043D\u0435\u0434\u0435\u043B\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717657
    m_Localized: "\u0421\u043A\u043E\u043F\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0441\u0430\u043C\u043E\u0433\u043E \u0434\u043E\u0440\u043E\u0433\u043E\u0433\u043E \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717658
    m_Localized: "\u041D\u0435\u043C\u043D\u043E\u0433\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0438 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043F\u0440\u043E\u0434\u0430\u0436\u0438 \u043C\u0435\u0441\u044F\u0446"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717659
    m_Localized: "\u041F\u0440\u0438\u0431\u044B\u043B\u044C \u2014 \u0437\u043D\u0430\u0447\u0438\u0442 \u043D\u0430\u043B\u043E\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717660
    m_Localized: "\u0422\u0432\u043E\u044F \u0442\u043E\u0447\u043A\u0430 \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E \u043F\u043E\u043A\u0440\u044B\u043B\u0430 \u0441\u0432\u043E\u0438 \u0440\u0430\u0441\u0445\u043E\u0434\u044B. \u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u044E: \u0442\u0435\u043F\u0435\u0440\u044C \u0435\u0441\u0442\u044C \u043F\u0440\u0438\u0431\u044B\u043B\u044C, \u0430 \u043F\u0440\u0438\u0431\u044B\u043B\u044C \u043E\u0431\u043B\u0430\u0433\u0430\u0435\u0442\u0441\u044F \u043D\u0430\u043B\u043E\u0433\u043E\u043C. \u0423 \u043D\u0430\u0451\u043C\u043D\u043E\u0433\u043E \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A\u0430 \u043D\u0430\u043B\u043E\u0433 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0442 \u0438\u0437 \u043A\u0430\u0436\u0434\u043E\u0439 \u0437\u0430\u0440\u043F\u043B\u0430\u0442\u044B, \u0430 \u0432\u043B\u0430\u0434\u0435\u043B\u0435\u0446 \u043F\u043B\u0430\u0442\u0438\u0442 \u0435\u0433\u043E \u0441\u0430\u043C. \u0412 \u0421\u0428\u0410 \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u044B \u043E\u0431\u044B\u0447\u043D\u043E \u0432\u043D\u043E\u0441\u044F\u0442 \u043D\u0430\u043B\u043E\u0433 \u0430\u0432\u0430\u043D\u0441\u043E\u043C \u0447\u0435\u0442\u044B\u0440\u0435 \u0440\u0430\u0437\u0430 \u0432 \u0433\u043E\u0434: \u0434\u043E 15 \u0430\u043F\u0440\u0435\u043B\u044F, 15 \u0438\u044E\u043D\u044F, 15 \u0441\u0435\u043D\u0442\u044F\u0431\u0440\u044F \u0438 15 \u044F\u043D\u0432\u0430\u0440\u044F. \u0421\u0430\u043C\u043E\u0437\u0430\u043D\u044F\u0442\u044B\u0435 \u043F\u043B\u0430\u0442\u044F\u0442 \u0435\u0449\u0451 \u0438 \u043D\u0430\u043B\u043E\u0433 \u043D\u0430 \u0441\u0430\u043C\u043E\u0437\u0430\u043D\u044F\u0442\u043E\u0441\u0442\u044C \u2014 15,3% \u043D\u0430 \u0441\u043E\u0446\u0441\u0442\u0440\u0430\u0445\u043E\u0432\u0430\u043D\u0438\u0435 \u0438 \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0443 \u0441 \u0431\u043E\u043B\u044C\u0448\u0435\u0439 \u0447\u0430\u0441\u0442\u0438 \u043F\u0440\u0438\u0431\u044B\u043B\u0438 \u2014 \u0441\u0432\u0435\u0440\u0445 \u043F\u043E\u0434\u043E\u0445\u043E\u0434\u043D\u043E\u0433\u043E \u043D\u0430\u043B\u043E\u0433\u0430. \u0417\u0430 \u043F\u0440\u043E\u043F\u0443\u0449\u0435\u043D\u043D\u044B\u0435 \u043F\u043B\u0430\u0442\u0435\u0436\u0438 \u043D\u0430\u0447\u0438\u0441\u043B\u044F\u044E\u0442 \u0448\u0442\u0440\u0430\u0444\u044B, \u0430 \u0432 \u0430\u043F\u0440\u0435\u043B\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442 \u0431\u043E\u043B\u0435\u0437\u043D\u0435\u043D\u043D\u044B\u0439 \u0441\u0447\u0451\u0442. \u041F\u0440\u0438\u0432\u044B\u0447\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0441\u043F\u0430\u0441\u0430\u0435\u0442 \u043E\u0441\u043D\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u0439, \u043F\u0440\u043E\u0441\u0442\u0430: \u043A\u0430\u0436\u0434\u044B\u0439 \u043C\u0435\u0441\u044F\u0446 \u043E\u0442\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0439 \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u0438\u0431\u044B\u043B\u0438 \u043D\u0430 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0439 \u043D\u0430\u043B\u043E\u0433\u043E\u0432\u044B\u0439 \u0441\u0447\u0451\u0442 \u0438 \u043D\u0435 \u0442\u0440\u043E\u0433\u0430\u0439 \u0435\u0433\u043E. \u0412 \u0438\u0433\u0440\u0435 \u043D\u0430\u043B\u043E\u0433\u043E\u0432\u044B\u0439 \u0440\u0435\u0437\u0435\u0440\u0432 \u043E\u0442\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0437\u0430 \u0442\u0435\u0431\u044F, \u0432 \u0436\u0438\u0437\u043D\u0438 \u044D\u0442\u043E\u0433\u043E \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0441\u0434\u0435\u043B\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717661
    m_Localized: "\u041A\u0430\u043A \u0447\u0430\u0441\u0442\u043E \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u044B \u0431\u0438\u0437\u043D\u0435\u0441\u0430 \u0432 \u0421\u0428\u0410 \u043E\u0431\u044B\u0447\u043D\u043E \u043F\u043B\u0430\u0442\u044F\u0442 \u043D\u0430\u043B\u043E\u0433 \u0430\u0432\u0430\u043D\u0441\u043E\u043C?"
