    m_Localized: "\u0427\u0442\u043E \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043A\u0430\u0441\u0441\u043E\u0432\u044B\u0439 \u0440\u0430\u0437\u0440\u044B\u0432 \u0431\u0435\u0437 \u043D\u043E\u0432\u043E\u0433\u043E \u0434\u043E\u0440\u043E\u0433\u043E\u0433\u043E \u0434\u043E\u043B\u0433\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717726
    m_Localized: "\u0420\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717727
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C \u0435\u0449\u0451 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717728
    m_Localized: "\u0421\u0447\u0451\u0442 \u0432 \u0434\u0435\u043D\u044C \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u0440\u0430\u0431\u043E\u0442\u044B \u0438 \u043F\u0440\u0435\u0434\u043E\u043F\u043B\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717729
    m_Localized: "\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u0442\u043E\u0438\u0442 \u0438 \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442 \u043A\u043B\u0438\u0435\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717730
    m_Localized: "\u041C\u0430\u0440\u043A\u0435\u0442\u0438\u043D\u0433 \u0442\u0440\u0430\u0442\u0438\u0442 \u0434\u0435\u043D\u044C\u0433\u0438 \u043D\u0430 \u043F\u0440\u0438\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0435 \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0441\u0447\u0438\u0442\u0430\u0439, \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u0442\u043E\u0438\u0442 \u043A\u043B\u0438\u0435\u043D\u0442 \u0438 \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043E\u043D \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442. \u0421\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u043F\u0440\u0438\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u044F, CAC, \u2014 \u044D\u0442\u043E \u0440\u0430\u0441\u0445\u043E\u0434\u044B \u043D\u0430 \u043C\u0430\u0440\u043A\u0435\u0442\u0438\u043D\u0433, \u0434\u0435\u043B\u0451\u043D\u043D\u044B\u0435 \u043D\u0430 \u0447\u0438\u0441\u043B\u043E \u043D\u043E\u0432\u044B\u0445 \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432: \u043B\u0438\u0441\u0442\u043E\u0432\u043A\u0438 \u0437\u0430 500 $, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u0440\u0438\u0432\u0435\u043B\u0438 100 \u043D\u043E\u0432\u044B\u0445 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0445 \u0433\u043E\u0441\u0442\u0435\u0439, \u2014 \u044D\u0442\u043E 5 $ \u0437\u0430 \u043A\u0430\u0436\u0434\u043E\u0433\u043E. \u041F\u043E\u0436\u0438\u0437\u043D\u0435\u043D\u043D\u0430\u044F \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u044C, LTV, \u2014 \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043A\u043B\u0438\u0435\u043D\u0442 \u043E\u0441\u0442\u0430\u0432\u0438\u0442 \u0437\u0430 \u0432\u0441\u0435 \u0432\u0438\u0437\u0438\u0442\u044B: \u043A\u043E\u0444\u0435, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 2,80 $, \u043A\u0443\u043F\u043B\u0435\u043D\u043D\u044B\u0439 20 \u0440\u0430\u0437, \u2014 \u044D\u0442\u043E 56 $. \u0420\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0451\u043D\u043D\u043E\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u043E: LTV \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u0442\u044C \u0445\u043E\u0442\u044F \u0431\u044B \u0432 \u0442\u0440\u0438 \u0440\u0430\u0437\u0430 \u0431\u043E\u043B\u044C\u0448\u0435 CAC. \u041D\u0438\u0436\u0435 \u2014 \u0440\u043E\u0441\u0442 \u0441\u044A\u0435\u0434\u0430\u0435\u0442 \u0442\u0432\u043E\u0438 \u0434\u0435\u043D\u044C\u0433\u0438, \u043D\u0430\u043C\u043D\u043E\u0433\u043E \u0432\u044B\u0448\u0435 \u2014 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0442\u044B \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u0430\u043B\u043E \u0432\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0448\u044C \u0432 \u0440\u043E\u0441\u0442. \u0421\u043B\u0435\u0434\u0438 \u0437\u0430 \u043E\u0431\u043E\u0438\u043C\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044F\u043C\u0438 \u043A\u0430\u0436\u0434\u044B\u0439 \u043C\u0435\u0441\u044F\u0446 \u2014 \u044D\u043A\u0440\u0430\u043D \xAB\u041A\u043E\u043C\u043F\u0430\u043D\u0438\u044F\xBB \u0434\u0435\u043B\u0430\u0435\u0442 \u044D\u0442\u043E \u0437\u0430 \u0442\u0435\u0431\u044F \u2014 \u0438 \u043E\u0442\u043A\u043B\u044E\u0447\u0430\u0439 \u043A\u0430\u043D\u0430\u043B\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u0440\u0438\u0432\u043E\u0434\u044F\u0442 \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432, \u043D\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0449\u0438\u0445\u0441\u044F \u0441\u043D\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
