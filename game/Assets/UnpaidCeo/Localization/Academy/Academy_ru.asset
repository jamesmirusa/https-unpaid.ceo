  m_TableData:
  - m_Id: 456122368
    m_Localized: CEO Academy
    m_Metadata:
      m_Items: []
  - m_Id: 468705280
    m_Localized: "\u0414\u0435\u043D\u044C\u0433\u0438 \u0432 \u0438\u0433\u0440\u0435 \u0441\u0438\u043C\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435. \u042D\u0442\u043E \u043D\u0435 \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u044B\u0439 \u0441\u043E\u0432\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 468705281
    m_Localized: "\u0418\u0433\u0440\u0430\u0439 \u0434\u0430\u043B\u044C\u0448\u0435, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u044D\u0442\u043E\u0442 \u0443\u0440\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 468705282
    m_Localized: "\u0412\u0435\u0440\u043D\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 468705283
    m_Localized: "\u041D\u0435 \u0441\u043E\u0432\u0441\u0435\u043C. \u041F\u0435\u0440\u0435\u0447\u0438\u0442\u0430\u0439 \u0443\u0440\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 468705284
    m_Localized: "\u041A\u0432\u0438\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 468705285
    m_Localized: "\u0412\u044B\u0440\u0443\u0447\u043A\u0430 \u0438 \u043F\u0440\u0438\u0431\u044B\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 468705286
    m_Localized: "\u0412\u044B\u0440\u0443\u0447\u043A\u0430 \u2014 \u044D\u0442\u043E \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u043E\u043B\u043B\u0430\u0440, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u0440\u0438\u0448\u0451\u043B. \u041F\u0440\u0438\u0431\u044B\u043B\u044C \u2014 \u0442\u043E, \u0447\u0442\u043E \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043F\u043E\u0441\u043B\u0435 \u043E\u043F\u043B\u0430\u0442\u044B \u0432\u0441\u0435\u0433\u043E, \u0447\u0442\u043E \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u043B\u043E\u0441\u044C, \u0447\u0442\u043E\u0431\u044B \u0435\u0433\u043E \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C: \u0442\u043E\u0432\u0430\u0440\u044B, \u043A\u043E\u043C\u0438\u0441\u0441\u0438\u0438 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0439, \u0432\u0435\u043B\u043E\u0441\u0438\u043F\u0435\u0434, \u0441\u0432\u044F\u0437\u044C, \u043D\u0430\u043B\u043E\u0433\u0438. \u041A\u0443\u0440\u044C\u0435\u0440 \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u044C 3\_000\_$ \u0432 \u043C\u0435\u0441\u044F\u0446, \u0430 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u043C\u0435\u043D\u044C\u0448\u0435. \u0411\u043E\u043B\u044C\u0448\u0438\u0435 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 \u0436\u0438\u0432\u0443\u0442 \u043F\u043E \u0442\u043E\u0439 \u0436\u0435 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435: \u0432 2012 \u0433\u043E\u0434\u0443 Amazon \u043F\u0440\u043E\u0434\u0430\u043B \u0442\u043E\u0432\u0430\u0440\u043E\u0432 \u043D\u0430 61\_\u043C\u043B\u0440\u0434\_$ \u0438 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u043F\u043E\u043A\u0430\u0437\u0430\u043B \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0443\u0431\u044B\u0442\u043E\u043A, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043F\u043E\u0447\u0442\u0438 \u0432\u0441\u0451 \u0432\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u043B \u0432 \u0440\u043E\u0441\u0442. \u041F\u0440\u0430\u0432\u0438\u043B\u043E: \u0445\u0432\u0430\u0441\u0442\u0430\u0439\u0441\u044F \u0432\u044B\u0440\u0443\u0447\u043A\u043E\u0439, \u043F\u043B\u0430\u043D\u0438\u0440\u0443\u0439 \u043F\u043E \u043F\u0440\u0438\u0431\u044B\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 468705287
    m_Localized: "\u0422\u044B \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u043B \u043D\u0430 \u043F\u043E\u0434\u0440\u0430\u0431\u043E\u0442\u043A\u0430\u0445 2\_000\_$ \u0438 \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u043B 600\_$ \u043D\u0430 \u0440\u0430\u0441\u0445\u043E\u0434\u044B. \u041A\u0430\u043A\u0430\u044F \u0443 \u0442\u0435\u0431\u044F \u043F\u0440\u0438\u0431\u044B\u043B\u044C \u0434\u043E \u043D\u0430\u043B\u043E\u0433\u043E\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 468705288
    m_Localized: "2\_000\_$"
    m_Metadata:
      m_Items: []
  - m_Id: 468705289
    m_Localized: "1\_400\_$"
    m_Metadata:
      m_Items: []
  - m_Id: 468705290
    m_Localized: "2\_600\_$"
    m_Metadata:
      m_Items: []
  - m_Id: 468705291
    m_Localized: "\u041A\u0430\u043A\u0430\u044F \u0446\u0438\u0444\u0440\u0430 \u043E\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u0435\u0442 \u0430\u0440\u0435\u043D\u0434\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 468705292
    m_Localized: "\u041F\u0440\u0438\u0431\u044B\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 468705293
    m_Localized: "\u0412\u044B\u0440\u0443\u0447\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 468705294
    m_Localized: "\u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0437\u0430\u043A\u0430\u0437\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 468705295
    m_Localized: "\u0412\u044B\u0440\u0443\u0447\u043A\u0430 \u0440\u0430\u0441\u0442\u0451\u0442, \u0430 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F \u0442\u0435\u0440\u044F\u0435\u0442 \u0434\u0435\u043D\u044C\u0433\u0438. \u0427\u0442\u043E \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u0435\u0435 \u0432\u0441\u0435\u0433\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 468705296
    m_Localized: "\u0412\u0441\u0451 \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435: \u0432\u0430\u0436\u043D\u0430 \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u044B\u0440\u0443\u0447\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 468705297
    m_Localized: "\u041E\u043D\u0430 \u043D\u0435 \u043F\u043B\u0430\u0442\u0438\u0442 \u043D\u0430\u043B\u043E\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 468705298
    m_Localized: "\u0415\u0451 \u0440\u0430\u0441\u0445\u043E\u0434\u044B \u0440\u0430\u0441\u0442\u0443\u0442 \u0442\u0430\u043A \u0436\u0435 \u0431\u044B\u0441\u0442\u0440\u043E, \u043A\u0430\u043A \u043F\u0440\u043E\u0434\u0430\u0436\u0438, \u0438\u043B\u0438 \u0431\u044B\u0441\u0442\u0440\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 468705299
    m_Localized: "\u0420\u0435\u0437\u0435\u0440\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 468705300
    m_Localized: "\u041F\u0440\u0438\u0448\u043B\u0438 \u043F\u0435\u0440\u0432\u044B\u0435 \u0441\u0447\u0435\u0442\u0430. \u0410\u0440\u0435\u043D\u0434\u0430, \u0435\u0434\u0430 \u0438 \u043C\u0435\u0442\u0440\u043E \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442 \u043A\u0430\u0436\u0434\u044B\u0439 \u043C\u0435\u0441\u044F\u0446 \u2014 \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0442\u044B \u0447\u0442\u043E-\u0442\u043E \u0438\u043B\u0438 \u043D\u0435\u0442. \u0420\u0435\u0437\u0435\u0440\u0432 \u2014 \u044D\u0442\u043E \u0434\u0435\u043D\u044C\u0433\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0442\u044B \u043E\u0442\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0448\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u043C\u0435\u0441\u044F\u0446\u044B, \u043A\u043E\u0433\u0434\u0430 \u0434\u043E\u0445\u043E\u0434\u0430 \u043D\u0435\u0442. \u041C\u043D\u043E\u0433\u0438\u0435 \u0441\u043E\u0432\u0435\u0442\u0443\u044E\u0442 \u043A\u043E\u043F\u0438\u0442\u044C \u043D\u0430 \u0442\u0440\u0438\u2013\u0448\u0435\u0441\u0442\u044C \u043C\u0435\u0441\u044F\u0446\u0435\u0432 \u0440\u0430\u0441\u0445\u043E\u0434\u043E\u0432. \u041D\u0430\u0447\u043D\u0438 \u0441 \u043C\u0435\u043D\u044C\u0448\u0435\u0433\u043E: \u0434\u0430\u0436\u0435 \u043E\u0434\u0438\u043D \u043C\u0435\u0441\u044F\u0446 \u0441\u0447\u0435\u0442\u043E\u0432 \u2014 \u044D\u0442\u043E \u0441\u0432\u043E\u0431\u043E\u0434\u0430, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043C\u043E\u0436\u043D\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u044C \xAB\u043D\u0435\u0442\xBB \u043F\u043B\u043E\u0445\u0438\u043C \u0441\u0434\u0435\u043B\u043A\u0430\u043C, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440 \u0440\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A\u0443. \u0412 \u0438\u0433\u0440\u0435 \u0440\u0435\u0437\u0435\u0440\u0432 \u043B\u0435\u0436\u0438\u0442 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E \u043E\u0442 \u0434\u0435\u043D\u0435\u0433 \u043D\u0430 \u0441\u0447\u0451\u0442\u0435, \u0438 \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C \u043F\u0435\u0440\u0432\u0443\u044E \u0433\u043B\u0430\u0432\u0443, \u0432 \u043D\u0451\u043C \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u0442\u044C \u043C\u0435\u0441\u044F\u0446 \u0441\u0447\u0435\u0442\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 468705301
    m_Localized: "\u0417\u0430\u0447\u0435\u043C \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0440\u0435\u0437\u0435\u0440\u0432 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E \u043E\u0442 \u0434\u0435\u043D\u0435\u0433 \u043D\u0430 \u0440\u0430\u0441\u0445\u043E\u0434\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 468705302
    m_Localized: "\u0427\u0442\u043E\u0431\u044B \u043D\u0430 \u043D\u0435\u0433\u043E \u043A\u0430\u043F\u0430\u043B\u0438 \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 468705303
    m_Localized: "\u0427\u0442\u043E\u0431\u044B \u043D\u0435 \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0442\u044C \u0435\u0433\u043E \u043D\u0430 \u043F\u043E\u0432\u0441\u0435\u0434\u043D\u0435\u0432\u043D\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 468705304
    m_Localized: "\u042D\u0442\u043E\u0433\u043E \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0431\u0430\u043D\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 468705305
    m_Localized: "\u0422\u0432\u043E\u0438 \u0441\u0447\u0435\u0442\u0430 \u2014 1\_700\_$ \u0432 \u043C\u0435\u0441\u044F\u0446. \u041A\u0430\u043A\u0430\u044F \u0445\u043E\u0440\u043E\u0448\u0430\u044F \u043F\u0435\u0440\u0432\u0430\u044F \u0446\u0435\u043B\u044C \u0434\u043B\u044F \u0440\u0435\u0437\u0435\u0440\u0432\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 468705306
    m_Localized: "170\_$"
    m_Metadata:
      m_Items: []
  - m_Id: 468705307
    m_Localized: "17\_000\_$, \u0438\u043D\u0430\u0447\u0435 \u043D\u0435\u043B\u044C\u0437\u044F \u043D\u0430\u0447\u0438\u043D\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 468705308
    m_Localized: "1\_700\_$"
    m_Metadata:
      m_Items: []
  - m_Id: 468705309
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u0442\u0440\u0430\u0442\u0438\u0442\u044C \u0440\u0435\u0437\u0435\u0440\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 468705310
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0434\u043E\u0445\u043E\u0434 \u0443\u043F\u0430\u043B, \u0430 \u0441\u0447\u0435\u0442\u0430 \u043D\u0443\u0436\u043D\u043E \u043F\u043B\u0430\u0442\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 468705311
    m_Localized: "\u0427\u0442\u043E\u0431\u044B \u0443\u0441\u043F\u0435\u0442\u044C \u043D\u0430 \u0441\u043A\u0438\u0434\u043A\u0443 \u043D\u0430 \u043D\u043E\u0432\u044B\u0439 \u0442\u0435\u043B\u0435\u0444\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 468705312
    m_Localized: "\u041D\u0438\u043A\u043E\u0433\u0434\u0430, \u043D\u0438 \u043F\u0440\u0438 \u043A\u0430\u043A\u0438\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 468705313
    m_Localized: "\u041A\u0430\u043A \u0447\u0438\u0442\u0430\u0442\u044C \u0443\u0431\u044B\u0442\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 468705314
    m_Localized: "\u0423\u0431\u044B\u0442\u043E\u043A \u0437\u043D\u0430\u0447\u0438\u0442, \u0447\u0442\u043E \u043C\u0435\u0441\u044F\u0446 \u0441\u0442\u043E\u0438\u043B \u0434\u043E\u0440\u043E\u0436\u0435, \u0447\u0435\u043C \u043F\u0440\u0438\u043D\u0451\u0441. \u042D\u0442\u043E \u043D\u0435 \u043F\u0440\u0438\u0433\u043E\u0432\u043E\u0440, \u044D\u0442\u043E \u0434\u0430\u043D\u043D\u044B\u0435. \u041E\u0442\u043A\u0440\u043E\u0439 \u043E\u0442\u0447\u0451\u0442 \u043E \u043F\u0440\u0438\u0431\u044B\u043B\u044F\u0445 \u0438 \u0443\u0431\u044B\u0442\u043A\u0430\u0445 \u0438 \u0437\u0430\u0434\u0430\u0439 \u0442\u0440\u0438 \u0432\u043E\u043F\u0440\u043E\u0441\u0430. \u0423\u043F\u0430\u043B\u0438 \u043F\u0440\u043E\u0434\u0430\u0436\u0438 \u0438\u043B\u0438 \u0432\u044B\u0440\u043E\u0441\u043B\u0438 \u0440\u0430\u0441\u0445\u043E\u0434\u044B? \u041A\u0430\u043A\u043E\u0439 \u0440\u0430\u0441\u0445\u043E\u0434 \u0440\u043E\u0441 \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u0432\u0441\u0435\u0445? \u042D\u0442\u043E \u0440\u0430\u0437\u043E\u0432\u044B\u0439 \u0443\u0434\u0430\u0440, \u043A\u0430\u043A \u0440\u0435\u043C\u043E\u043D\u0442, \u0438\u043B\u0438 \u043E\u043D \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0442\u044C\u0441\u044F \u043A\u0430\u0436\u0434\u044B\u0439 \u043C\u0435\u0441\u044F\u0446? \u0423\u0431\u044B\u0442\u043A\u0438 \u0431\u044B\u0432\u0430\u044E\u0442 \u0438 \u0443 \u0433\u0438\u0433\u0430\u043D\u0442\u043E\u0432: Uber \u0433\u043E\u0434\u0430\u043C\u0438 \u0442\u0435\u0440\u044F\u043B \u0434\u0435\u043D\u044C\u0433\u0438, \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0432 2023 \u0433\u043E\u0434\u0443 \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u043B \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u043E\u043D\u043D\u0443\u044E \u043F\u0440\u0438\u0431\u044B\u043B\u044C \u0437\u0430 \u043F\u043E\u043B\u043D\u044B\u0439 \u0433\u043E\u0434. \u0420\u0430\u0437\u043D\u0438\u0446\u0430 \u043C\u0435\u0436\u0434\u0443 \u0443\u0431\u044B\u0442\u043A\u043E\u043C \u0438 \u043A\u0430\u0442\u0430\u0441\u0442\u0440\u043E\u0444\u043E\u0439 \u2014 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C \u043B\u0438 \u0442\u044B, \u043E\u0442\u043A\u0443\u0434\u0430 \u043E\u043D \u0432\u0437\u044F\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 468705315
    m_Localized: "\u041C\u0435\u0441\u044F\u0446 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0441\u044F \u0443\u0431\u044B\u0442\u043A\u043E\u043C. \u0427\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043F\u0435\u0440\u0432\u044B\u043C \u0434\u0435\u043B\u043E\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 468705316
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u0440\u0430\u0441\u0445\u043E\u0434\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0440\u043E\u0441\u043B\u0438 \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u043F\u0440\u043E\u0434\u0430\u0436"
    m_Metadata:
      m_Items: []
  - m_Id: 468705317
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u0431\u0438\u0437\u043D\u0435\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 468705318
    m_Localized: "\u0421\u0440\u0430\u0437\u0443 \u043F\u043E\u0434\u043D\u044F\u0442\u044C \u0432\u0441\u0435 \u0446\u0435\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 468705319
    m_Localized: "\u0423\u0431\u044B\u0442\u043E\u043A \u043C\u0435\u0441\u044F\u0446\u0430 \u0438\u0437-\u0437\u0430 \u0440\u0435\u043C\u043E\u043D\u0442\u0430 \u0432\u0435\u043B\u043E\u0441\u0438\u043F\u0435\u0434\u0430 \u0437\u0430 200\_$. \u0427\u0442\u043E \u044D\u0442\u043E \u0437\u0430 \u0440\u0430\u0441\u0445\u043E\u0434?"
    m_Metadata:
      m_Items: []
  - m_Id: 468705320
    m_Localized: "\u0420\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 468705321
    m_Localized: "\u0420\u0430\u0437\u043E\u0432\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 468705322
    m_Localized: "\u041D\u0430\u043B\u043E\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 468705323
    m_Localized: "\u041A\u0430\u043A\u043E\u0435 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435 \u0432\u0435\u0440\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 468705324
    m_Localized: "\u0423 \u043F\u0440\u0438\u0431\u044B\u043B\u044C\u043D\u044B\u0445 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0439 \u043D\u0435 \u0431\u044B\u0432\u0430\u0435\u0442 \u0443\u0431\u044B\u0442\u043E\u0447\u043D\u044B\u0445 \u043C\u0435\u0441\u044F\u0446\u0435\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 468705325
    m_Localized: "\u0423\u0431\u044B\u0442\u043E\u043A \u0437\u043D\u0430\u0447\u0438\u0442, \u0447\u0442\u043E \u0432\u044B\u0440\u0443\u0447\u043A\u0438 \u043D\u0435 \u0431\u044B\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 468705326
    m_Localized: "\u0423\u0431\u044B\u0442\u043E\u043A \u2014 \u044D\u0442\u043E \u0434\u0430\u043D\u043D\u044B\u0435: \u043E\u043D \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442, \u0447\u0442\u043E \u0438\u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 468705327
    m_Localized: "\u041A\u0430\u0441\u0441\u043E\u0432\u044B\u0439 \u0440\u0430\u0437\u0440\u044B\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 468705328
    m_Localized: "\u041A\u0430\u0441\u0441\u043E\u0432\u044B\u0439 \u0440\u0430\u0437\u0440\u044B\u0432 \u2014 \u044D\u0442\u043E \u043A\u043E\u0433\u0434\u0430 \u0434\u0435\u043D\u044C\u0433\u0438 \u043D\u0443\u0436\u043D\u043E \u043E\u0442\u0434\u0430\u0442\u044C \u0440\u0430\u043D\u044C\u0448\u0435, \u0447\u0435\u043C \u043E\u043D\u0438 \u043F\u0440\u0438\u0434\u0443\u0442. \u0410\u0440\u0435\u043D\u0434\u0430 \u2014 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0447\u0438\u0441\u043B\u0430, \u0430 \u043A\u043B\u0438\u0435\u043D\u0442 \u043F\u043B\u0430\u0442\u0438\u0442 \u0447\u0435\u0440\u0435\u0437 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u0434\u043D\u0435\u0439. \u041D\u0430 \u0431\u0443\u043C\u0430\u0433\u0435 \u0442\u044B \u0432 \u043F\u0440\u0438\u0431\u044B\u043B\u0438, \u0430 \u043D\u0430 \u0441\u0447\u0451\u0442\u0435 \u2014 \u043C\u0438\u043D\u0443\u0441. \u0422\u0430\u043A \u0440\u0430\u0437\u043E\u0440\u044F\u044E\u0442\u0441\u044F \u0434\u0430\u0436\u0435 \u043F\u0440\u0438\u0431\u044B\u043B\u044C\u043D\u044B\u0435 \u043C\u0430\u043B\u044B\u0435 \u0431\u0438\u0437\u043D\u0435\u0441\u044B: \u0443 \u043D\u0438\u0445 \u043F\u0440\u043E\u0441\u0442\u043E \u043A\u043E\u043D\u0447\u0430\u044E\u0442\u0441\u044F \u0434\u0435\u043D\u044C\u0433\u0438. \u0417\u0430\u043A\u0440\u044B\u0442\u044C \u0440\u0430\u0437\u0440\u044B\u0432 \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442 \u0442\u0440\u0438 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430: \u0440\u0435\u0437\u0435\u0440\u0432, \u0431\u043E\u043B\u0435\u0435 \u0431\u044B\u0441\u0442\u0440\u0430\u044F \u043E\u043F\u043B\u0430\u0442\u0430 \u043E\u0442 \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432 \u0438 \u043E\u0442\u0441\u0440\u043E\u0447\u043A\u0430 \u043F\u043B\u0430\u0442\u0435\u0436\u0435\u0439 \u043F\u043E\u0441\u0442\u0430\u0432\u0449\u0438\u043A\u0430\u043C \u043F\u043E \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0451\u043D\u043D\u043E\u0441\u0442\u0438. \u0414\u043E\u0440\u043E\u0433\u043E\u0439 \u0434\u043E\u043B\u0433, \u043A\u0430\u043A \u0443 \u0440\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A\u0430, \u2014 \u0445\u0443\u0434\u0448\u0438\u0439 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442: \u043E\u043D \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0440\u0430\u0437\u0440\u044B\u0432 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0438 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u0438\u0439 \u0437\u0430\u0432\u0442\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 468705329
    m_Localized: "\u041D\u0430 \u0431\u0443\u043C\u0430\u0433\u0435 \u0442\u044B \u0432 \u043F\u0440\u0438\u0431\u044B\u043B\u0438, \u0430 \u0431\u0430\u043B\u0430\u043D\u0441 \u043E\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439. \u041A\u0430\u043A \u044D\u0442\u043E \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 468705330
