  - m_Id: 90748379717641
    m_Localized: "\u041A\u0430\u0436\u0434\u0430\u044F \u043F\u0440\u043E\u0434\u0430\u0436\u0430 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442 50 \u0446\u0435\u043D\u0442\u043E\u0432 \u0443\u0431\u044B\u0442\u043A\u0430. \u0427\u0442\u043E \u0431\u0443\u0434\u0435\u0442, \u0435\u0441\u043B\u0438 \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u0442\u044C \u0432\u0434\u0432\u043E\u0435 \u0431\u043E\u043B\u044C\u0448\u0435?"
