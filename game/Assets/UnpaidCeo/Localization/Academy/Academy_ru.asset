    m_Localized: "\u041F\u043B\u0430\u0442\u0438\u0442 30 $ \u0437\u0430 \u0437\u0430\u043A\u0430\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717721
    m_Localized: "\u0422\u044B \u0431\u0435\u0440\u0451\u0448\u044C \u0432\u0441\u0451 \u0431\u043E\u043B\u044C\u0448\u0435 B2B-\u0437\u0430\u043A\u0430\u0437\u043E\u0432, \u0430 \u0434\u0435\u043D\u0435\u0433 \u043D\u0430 \u0441\u0447\u0451\u0442\u0435 \u0432\u0441\u0451 \u043C\u0435\u043D\u044C\u0448\u0435. \u041A\u0430\u043A\u0430\u044F \u043F\u0440\u0438\u0447\u0438\u043D\u0430 \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u0435\u0435 \u0432\u0441\u0435\u0433\u043E?"
    m_Metadata:
