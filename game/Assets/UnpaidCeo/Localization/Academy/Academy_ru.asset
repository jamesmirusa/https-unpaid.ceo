  - m_Id: 90748379717686
    m_Localized: "\u0415\u0451 \u043F\u0440\u0430\u0432\u043E \u0432\u0435\u0441\u0442\u0438 \u0431\u0438\u0437\u043D\u0435\u0441 \u043F\u0440\u0438\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442, \u043F\u043E\u043A\u0430 \u043E\u043D\u0430 \u043D\u0435 \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u0443\u0435\u0442 \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717687
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717688
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A \u043C\u0435\u043D\u044F\u0435\u0442 \u0442\u0432\u043E\u044E \u0440\u0430\u0431\u043E\u0442\u0443: \u0442\u0435\u043F\u0435\u0440\u044C \u0442\u044B \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0438\u0448\u044C, \u0430 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0448\u044C. \u041D\u0430\u043D\u0438\u043C\u0430\u0439 \u0442\u0443\u0434\u0430, \u0433\u0434\u0435 \u043F\u0440\u043E\u0431\u0435\u043B \u043E\u0431\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0434\u043E\u0440\u043E\u0436\u0435 \u0432\u0441\u0435\u0433\u043E: \u0441\u043C\u0435\u043D\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0442\u044B \u043D\u0435 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0448\u044C, \u0437\u0432\u043E\u043D\u043A\u0438, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043D\u0435 \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u0448\u044C \u043E\u0442\u0432\u0435\u0442\u0438\u0442\u044C. \u0412 \u041D\u044C\u044E-\u0419\u043E\u0440\u043A\u0435 \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F \u043E\u043F\u043B\u0430\u0442\u0430 \u0432 2026 \u0433\u043E\u0434\u0443 \u2014 17 $ \u0432 \u0447\u0430\u0441, \u0430 \u0447\u0430\u0441\u044B \u0441\u0432\u0435\u0440\u0445 40 \u0432 \u043D\u0435\u0434\u0435\u043B\u044E \u043E\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u0432 \u043F\u043E\u043B\u0443\u0442\u043E\u0440\u043D\u043E\u043C \u0440\u0430\u0437\u043C\u0435\u0440\u0435. \u0414\u043E \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0440\u0430\u0431\u043E\u0447\u0435\u0433\u043E \u0434\u043D\u044F \u043D\u0443\u0436\u043D\u044B EIN, \u0444\u043E\u0440\u043C\u0430 I-9 \u0434\u043B\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438 \u043F\u0440\u0430\u0432\u0430 \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0443, \u043D\u0430\u043B\u043E\u0433\u043E\u0432\u044B\u0435 \u0444\u043E\u0440\u043C\u044B, \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u043A\u0438 \u043E\u0442 \u043D\u0435\u0441\u0447\u0430\u0441\u0442\u043D\u044B\u0445 \u0441\u043B\u0443\u0447\u0430\u0435\u0432 \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0435 \u0438 \u043F\u043E \u043D\u0435\u0442\u0440\u0443\u0434\u043E\u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438, \u0430 \u043E \u043D\u043E\u0432\u043E\u043C \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0435 \u043D\u0443\u0436\u043D\u043E \u0441\u043E\u043E\u0431\u0449\u0438\u0442\u044C \u0448\u0442\u0430\u0442\u0443 \u041D\u044C\u044E-\u0419\u043E\u0440\u043A \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 20 \u0434\u043D\u0435\u0439. \u0425\u043E\u0440\u043E\u0448\u0438\u0439 \u043F\u0435\u0440\u0432\u044B\u0439 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A \u043E\u043A\u0443\u043F\u0430\u0435\u0442\u0441\u044F, \u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0430\u044F \u0442\u0432\u043E\u0451 \u0432\u0440\u0435\u043C\u044F \u0434\u043B\u044F \u043F\u0440\u043E\u0434\u0430\u0436 \u0438 \u043F\u043B\u0430\u043D\u043E\u0432, \u043D\u0435\u0443\u0434\u0430\u0447\u043D\u044B\u0439 \u0441\u0442\u043E\u0438\u0442 \u043C\u0435\u0441\u044F\u0446\u0435\u0432. \u041F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u0442\u044C \u0432\u0430\u043A\u0430\u043D\u0441\u0438\u044E, \u0437\u0430\u043F\u0438\u0448\u0438, \u043A\u0430\u043A \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u0443\u0441\u043F\u0435\u0445 \u0447\u0435\u0440\u0435\u0437 30 \u0434\u043D\u0435\u0439."
    m_Metadata:
      m_Items: []
