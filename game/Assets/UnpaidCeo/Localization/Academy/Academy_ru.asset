  - m_Id: 90748379717739
    m_Localized: "\u041A\u0430\u043A\u043E\u0435 \u0441\u043E\u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0435 LTV \u043A CAC \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u0437\u0434\u043E\u0440\u043E\u0432\u044B\u043C \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u043C?"
