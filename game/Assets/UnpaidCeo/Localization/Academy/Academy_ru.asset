    m_Localized: "\u041E\u0442\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0442\u044C \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u0438\u0431\u044B\u043B\u0438 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u043C\u0435\u0441\u044F\u0446\u0430 \u043D\u0430 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0439 \u043D\u0430\u043B\u043E\u0433\u043E\u0432\u044B\u0439 \u0441\u0447\u0451\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717673
    m_Localized: "\u0417\u0430\u0447\u0435\u043C \u043D\u0443\u0436\u043D\u0430 LLC"
    m_Metadata:
      m_Items: []
  - m_Id: 90748379717674
    m_Localized: "\u041F\u0435\u0440\u0435\u0435\u0437\u0434 \u0432 \u0411\u0440\u0443\u043A\u043B\u0438\u043D \u2014 \u044D\u0442\u043E \u0443\u0436\u0435 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u0431\u0438\u0437\u043D\u0435\u0441, \u0430 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C\u0443 \u0431\u0438\u0437\u043D\u0435\u0441\u0443 \u043D\u0443\u0436\u043D\u0430 \u044E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0444\u043E\u0440\u043C\u0430. \u041A\u043E\u0433\u0434\u0430 \u0442\u044B \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u044B\u0439 \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C, \u0442\u044B \u0438 \u0431\u0438\u0437\u043D\u0435\u0441 \u2014 \u043E\u0434\u043D\u043E \u043B\u0438\u0446\u043E: \u0435\u0441\u043B\u0438 \u0431\u0438\u0437\u043D\u0435\u0441 \u0434\u043E\u043B\u0436\u0435\u043D \u0434\u0435\u043D\u0435\u0433 \u0438\u043B\u0438 \u043D\u0430 \u043D\u0435\u0433\u043E \u043F\u043E\u0434\u0430\u043B\u0438 \u0432 \u0441\u0443\u0434, \u043F\u043E\u0434 \u0443\u0434\u0430\u0440\u043E\u043C \u0442\u0432\u043E\u0438 \u043B\u0438\u0447\u043D\u044B\u0435 \u0441\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u0438\u044F. \u041A\u043E\u043C\u043F\u0430\u043D\u0438\u044F \u0441 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u043E\u0439 \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C\u044E, LLC, \u0441\u0442\u0430\u0432\u0438\u0442 \u0441\u0442\u0435\u043D\u0443 \u043C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438. \u0412 \u041D\u044C\u044E-\u0419\u043E\u0440\u043A\u0435 \u0435\u0451 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044F \u0441\u0442\u043E\u0438\u0442 200 $ \u0437\u0430 \u043F\u043E\u0434\u0430\u0447\u0443 Articles of Organization \u0432 \u0414\u0435\u043F\u0430\u0440\u0442\u0430\u043C\u0435\u043D\u0442 \u0448\u0442\u0430\u0442\u0430. \u0414\u0430\u043B\u044C\u0448\u0435 \u2014 \u043D\u044C\u044E-\u0439\u043E\u0440\u043A\u0441\u043A\u0430\u044F \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044C: \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 120 \u0434\u043D\u0435\u0439 \u043D\u0443\u0436\u043D\u043E \u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u0442\u044C \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u0435 \u0432 \u0434\u0432\u0443\u0445 \u0433\u0430\u0437\u0435\u0442\u0430\u0445, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0432\u044B\u0431\u0435\u0440\u0435\u0442 \u0441\u0435\u043A\u0440\u0435\u0442\u0430\u0440\u044C \u043E\u043A\u0440\u0443\u0433\u0430, \u0448\u0435\u0441\u0442\u044C \u043D\u0435\u0434\u0435\u043B\u044C \u043F\u043E\u0434\u0440\u044F\u0434, \u0438 \u043F\u043E\u0434\u0430\u0442\u044C Certificate of Publication \u0437\u0430 50 $. \u0412 \u041D\u044C\u044E-\u0419\u043E\u0440\u043A\u0435 \u043E\u0434\u043D\u0438 \u0442\u043E\u043B\u044C\u043A\u043E \u0433\u0430\u0437\u0435\u0442\u044B \u043C\u043E\u0433\u0443\u0442 \u0441\u0442\u043E\u0438\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435 1 000 $. \u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0448\u044C \u2014 LLC \u0442\u0435\u0440\u044F\u0435\u0442 \u043F\u0440\u0430\u0432\u043E \u0432\u0435\u0441\u0442\u0438 \u0431\u0438\u0437\u043D\u0435\u0441, \u043F\u043E\u043A\u0430 \u0442\u044B \u044D\u0442\u043E \u043D\u0435 \u0438\u0441\u043F\u0440\u0430\u0432\u0438\u0448\u044C."
    m_Metadata:
      m_Items: []
