  - m_Id: 879340878290957
    m_Localized: "Unpaid CEO \xB7 \u0442\u0432\u043E\u0439 \u043D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290958
    m_Localized: "\u0414\u043E\u043C \u2014 \u0442\u0432\u043E\u044F \u0431\u0430\u0437\u0430. \u041D\u0435 \u0432\u044B\u0441\u043F\u0438\u0448\u044C\u0441\u044F \u2014 \u0437\u0430\u0432\u0442\u0440\u0430 \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0448\u044C \u043C\u0435\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290959
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0437\u0430\u043F\u043B\u0430\u0442\u0438 \u0441\u0435\u0431\u0435: \u043E\u0442\u043B\u043E\u0436\u0438 \u0445\u043E\u0442\u044C \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0448\u044C \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290960
    m_Localized: "\u0421\u0435\u043C\u044C\u044F \u2014 \u043D\u0435 \u0441\u0442\u0430\u0442\u044C\u044F \u0440\u0430\u0441\u0445\u043E\u0434\u043E\u0432. \u042D\u0442\u043E \u0442\u0435, \u043A\u0442\u043E \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F, \u043A\u043E\u0433\u0434\u0430 \u0434\u0435\u043D\u044C\u0433\u0438 \u043A\u043E\u043D\u0447\u0430\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290961
    m_Localized: "\u0411\u043E\u0434\u0435\u0433\u0430 \u0422\u043E\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290962
    m_Localized: "\u0422\u043E\u043D\u0438 \xB7 \u0445\u043E\u0437\u044F\u0438\u043D \u0431\u043E\u0434\u0435\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290963
    m_Localized: "\u0423 \u043C\u0435\u043D\u044F \u043C\u0430\u0440\u0436\u0430 \u2014 \u0446\u0435\u043D\u0442\u044B \u0441 \u0431\u0430\u043D\u043A\u0438. \u0416\u0438\u0432\u0443 \u043D\u0430 \u043E\u0431\u043E\u0440\u043E\u0442\u0435, \u0430 \u043D\u0435 \u043D\u0430 \u043D\u0430\u0446\u0435\u043D\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290964
    m_Localized: "\u041D\u0443\u0436\u043D\u044B \u0440\u0443\u043A\u0438 \u043D\u0430 \u0440\u0430\u0437\u0433\u0440\u0443\u0437\u043A\u0443. \u041F\u043B\u0430\u0447\u0443 \u0441\u0440\u0430\u0437\u0443, \u043D\u0430\u043B\u0438\u0447\u043D\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290965
    m_Localized: "\u0417\u0430\u043F\u043E\u043C\u043D\u0438 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044F \u043F\u043E \u0438\u043C\u0435\u043D\u0438 \u2014 \u0438 \u043E\u043D \u043F\u0440\u043E\u0439\u0434\u0451\u0442 \u043C\u0438\u043C\u043E \u0442\u0440\u0451\u0445 \u0434\u0440\u0443\u0433\u0438\u0445 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043E\u0432 \u043A \u0442\u0435\u0431\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290966
    m_Localized: "\u0411\u0430\u0440-\u043F\u0438\u0446\u0446\u0435\u0440\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290967
    m_Localized: "\u0414\u0436\u0435\u0439 \xB7 \u043B\u0443\u0447\u0448\u0438\u0439 \u0434\u0440\u0443\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290968
    m_Localized: "\u041F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u0437\u0430\u043A\u0430\u0437\u043E\u0432 \u0432 \u044D\u0442\u043E\u043C \u0433\u043E\u0440\u043E\u0434\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442 \u0447\u0435\u0440\u0435\u0437 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0445. \u0421\u0430\u0434\u0438\u0441\u044C, \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u043B\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290969
    m_Localized: "\u041E\u043F\u044F\u0442\u044C \u043E\u0434\u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0430? \u0421\u0433\u043E\u0440\u0438\u0448\u044C \u2014 \u0438 \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290970
    m_Localized: "\u0417\u0430 \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u043C \u0441\u0442\u043E\u043B\u043E\u043C \u0441\u0438\u0434\u044F\u0442 \u0442\u0435, \u043A\u0442\u043E \u043D\u0430\u043D\u0438\u043C\u0430\u0435\u0442. \u0423\u0433\u043E\u0441\u0442\u0438 \u0438\u0445 \u043A\u0443\u0441\u043A\u043E\u043C \u043F\u0438\u0446\u0446\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290971
    m_Localized: "\u041E\u0444\u0438\u0441 \u0432 \u043F\u0440\u0430\u0447\u0435\u0447\u043D\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290972
    m_Localized: "\u0421\u044D\u043C \xB7 \u0431\u0443\u0434\u0443\u0449\u0438\u0439 \u043F\u0430\u0440\u0442\u043D\u0451\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290973
    m_Localized: "\u041F\u0440\u0430\u0447\u0435\u0447\u043D\u0430\u044F, \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B\u0439 \u0432\u0430\u0439\u0444\u0430\u0439, \u0433\u0443\u043B \u043C\u0430\u0448\u0438\u043D. \u041B\u0443\u0447\u0448\u0438\u0439 \u043E\u0444\u0438\u0441, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043D\u0430\u043C \u043F\u043E \u043A\u0430\u0440\u043C\u0430\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290974
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u043B\u0430\u043D, \u043F\u043E\u0442\u043E\u043C \u043C\u0435\u0441\u044F\u0446. \u0418\u043D\u0430\u0447\u0435 \u043C\u0435\u0441\u044F\u0446 \u0440\u0435\u0448\u0438\u0442 \u0437\u0430 \u0442\u0435\u0431\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290975
    m_Localized: "\u0421\u043C\u043E\u0442\u0440\u0438 \u0432 \u043E\u0442\u0447\u0451\u0442 \u043A\u0430\u0436\u0434\u044B\u0439 \u043C\u0435\u0441\u044F\u0446. \u0426\u0438\u0444\u0440\u044B \u043D\u0435 \u0432\u0440\u0443\u0442, \u0434\u0430\u0436\u0435 \u043A\u043E\u0433\u0434\u0430 \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0447\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290976
    m_Localized: "\u041B\u043E\u043C\u0431\u0430\u0440\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290977
    m_Localized: "\u041C\u0438\u0441\u0442\u0435\u0440 \u0424\u0438\u043D\u0441 \xB7 \u0434\u0430\u0451\u0442 \u0432 \u0434\u043E\u043B\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290978
    m_Localized: "\u0414\u0435\u043D\u044C\u0433\u0438 \u0441\u0435\u0433\u043E\u0434\u043D\u044F. \u0412\u043E\u043F\u0440\u043E\u0441\u043E\u0432 \u043D\u0435 \u0437\u0430\u0434\u0430\u044E. \u041F\u0440\u043E\u0446\u0435\u043D\u0442\u044B \u2014 \u043F\u043E\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290979
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u044B\u0435 \u0434\u0435\u043D\u044C\u0433\u0438 \u2014 \u0441\u0430\u043C\u044B\u0435 \u0434\u043E\u0440\u043E\u0433\u0438\u0435. \u041D\u043E \u0442\u044B \u0436\u0435 \u0442\u043E\u0440\u043E\u043F\u0438\u0448\u044C\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290980
    m_Localized: "\u0415\u0441\u0442\u044C \u043E\u0434\u043D\u0430 \u0441\u0445\u0435\u043C\u0430. \u041D\u0435 \u0441\u043E\u0432\u0441\u0435\u043C \u0447\u0438\u0441\u0442\u0430\u044F. \u0417\u0430\u0442\u043E \u0431\u044B\u0441\u0442\u0440\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290981
    m_Localized: "\u0411\u0430\u043D\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290982
    m_Localized: "\u041C\u0438\u0441\u0441 \u041B\u0438 \xB7 \u0431\u0430\u043D\u043A\u0438\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290983
    m_Localized: "\u0420\u0435\u0437\u0435\u0440\u0432 \u2014 \u044D\u0442\u043E \u0434\u0435\u043D\u044C\u0433\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u043E\u043A\u0443\u043F\u0430\u044E\u0442 \u0432\u0430\u043C \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0439 \u0441\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290984
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0442\u0440\u0438 \u043C\u0435\u0441\u044F\u0446\u0430 \u0440\u0430\u0441\u0445\u043E\u0434\u043E\u0432 \u0432 \u0440\u0435\u0437\u0435\u0440\u0432\u0435. \u0420\u0438\u0441\u043A \u2014 \u043F\u043E\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290985
    m_Localized: "\u0411\u0430\u043D\u043A \u0434\u0430\u0451\u0442 \u043A\u0440\u0435\u0434\u0438\u0442 \u0442\u0435\u043C, \u043A\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u043F\u0440\u0438\u0431\u044B\u043B\u044C. \u041F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0435 \u0441 \u0446\u0438\u0444\u0440\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290986
    m_Localized: "\u0410\u043A\u0430\u0434\u0435\u043C\u0438\u044F CEO"
    m_Metadata:
      m_Items: []
  - m_Id: 879340878290987
    m_Localized: "Unpaid CEO \xB7 \u0432\u0435\u0434\u0451\u0442 \u0437\u0430\u043D\u044F\u0442\u0438\u044F"
    m_Metadata:
