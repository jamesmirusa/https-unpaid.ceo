  - m_Id: 94522578034688
    m_Localized: "\u0422\u0432\u043E\u0451 \u0440\u0430\u0431\u043E\u0447\u0435\u0435 \u0432\u0440\u0435\u043C\u044F \u0442\u0435\u043F\u0435\u0440\u044C \u0443\u0445\u043E\u0434\u0438\u0442 \u043D\u0430 \u0431\u0438\u0437\u043D\u0435\u0441. \u041F\u0440\u0438 60% \u0440\u0430\u0431\u043E\u0442\u044B \u0442\u044B \u2014 \u043F\u043E\u043B\u043D\u043E\u0446\u0435\u043D\u043D\u044B\u0439 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A, \u0430 \u043F\u043E\u0434\u0440\u0430\u0431\u043E\u0442\u043A\u0438 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043F\u043B\u0430\u0442\u044F\u0442."
