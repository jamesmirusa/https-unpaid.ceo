  - m_Id: 829442678054918
    m_Localized: "\u0426\u0435\u043B\u044C: \u043D\u0430\u043A\u043E\u043F\u0438\u0442\u044C \u0434\u0435\u043D\u044C\u0433\u0438 \u0438 \u0440\u0435\u0437\u0435\u0440\u0432 \u043D\u0430 \u043C\u0435\u0441\u044F\u0446 \u0436\u0438\u0437\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 829442678054919
    m_Localized: "\u0426\u0435\u043B\u044C: \u0432\u044B\u0439\u0442\u0438 \u0432 \u043D\u043E\u043B\u044C \u0438 \u0434\u043E\u0432\u0435\u0441\u0442\u0438 \u043A\u0430\u043F\u0438\u0442\u0430\u043B \u0434\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 829442678054920
    m_Localized: "\u0426\u0435\u043B\u044C: \u0434\u0432\u0435 \u0442\u043E\u0447\u043A\u0438 \u0438 \u043A\u043E\u043C\u0430\u043D\u0434\u0430 \u0438\u043B\u0438 \u043A\u0430\u043F\u0438\u0442\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 829442678054921
    m_Localized: "\u0421\u043F\u043B\u0430\u043D\u0438\u0440\u0443\u0439 \u043D\u0435\u0434\u0435\u043B\u044E: \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0438 \u0434\u0435\u043D\u044C \u0438 \u0432\u044B\u0431\u0435\u0440\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F. \u041F\u043E\u0442\u043E\u043C \u0436\u043C\u0438 \xAB\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F \u043D\u0435\u0434\u0435\u043B\u044F\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 829442678054922
    m_Localized: "\u0421\u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u043D\u0435\u0434\u0435\u043B\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 829442678054923
    m_Localized: "\u041D\u0435\u0434\u0435\u043B\u0438 \u043D\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0438\u0441\u044C. \u041F\u043E\u043A\u0430 \u043F\u0440\u043E\u0439\u0434\u0438 \u0443\u0440\u043E\u043A: \u044D\u0442\u043E \u0434\u0432\u0435 \u043C\u0438\u043D\u0443\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 829442678054924
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u0443\u0440\u043E\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 829442678054925
    m_Localized: "\u042D\u0442\u0430 \u043D\u0435\u0434\u0435\u043B\u044F \u043E\u0442\u043A\u0440\u044B\u043B\u0430 \u043D\u043E\u0432\u044B\u0439 \u0443\u0440\u043E\u043A. \u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0439 \u0435\u0433\u043E \u0438 \u043E\u0442\u0432\u0435\u0442\u044C \u043D\u0430 \u0432\u043E\u043F\u0440\u043E\u0441\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 829442678054926
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u0443\u0440\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 829442678054927
    m_Localized: "\u0414\u0435\u043D\u0435\u0433 \u043C\u0435\u043D\u044C\u0448\u0435 \u043D\u0443\u043B\u044F. \u041F\u043E\u043C\u0435\u043D\u044F\u0439 \u043F\u043B\u0430\u043D \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u043D\u0435\u0434\u0435\u043B\u0438: \u0431\u043E\u043B\u044C\u0448\u0435 \u043E\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u0435\u043C\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B, \u043C\u0435\u043D\u044C\u0448\u0435 \u0442\u0440\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 829442678054928
    m_Localized: "\u0418\u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u043F\u043B\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 829442678054929
    m_Localized: "\u041F\u043E\u0440\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u0431\u0438\u0437\u043D\u0435\u0441. \u0421\u0440\u0430\u0432\u043D\u0438 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u044B \u0438 \u0432\u044B\u0431\u0435\u0440\u0438 \u043E\u0434\u0438\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 829442678054930
    m_Localized: "\u0412\u044B\u0431\u0440\u0430\u0442\u044C \u0431\u0438\u0437\u043D\u0435\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 829442678054931
    m_Localized: "\u0426\u0435\u043B\u044C \u0433\u043B\u0430\u0432\u044B \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0430! \u041F\u0435\u0440\u0435\u0435\u0437\u0436\u0430\u0439 \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0440\u0430\u0439\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 829442678054932
    m_Localized: "\u041D\u043E\u0432\u0430\u044F \u0433\u043B\u0430\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 829442678054933
    m_Localized: "\u041C\u0435\u0441\u044F\u0446"
    m_Metadata:
      m_Items: []
  - m_Id: 829442678054934
    m_Localized: "\u0412\u044B\u0440\u0443\u0447\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 829442678054935
    m_Localized: "\u0427\u0438\u0441\u0442\u0430\u044F \u043F\u0440\u0438\u0431\u044B\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 829442678054936
    m_Localized: "\u041B\u0438\u0447\u043D\u044B\u0435 \u0440\u0430\u0441\u0445\u043E\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 829442678054937
    m_Localized: "\u0414\u0435\u043D\u0435\u0433 \u043D\u0430 \u0441\u0447\u0451\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 829442678054938
    m_Localized: "\u0418\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u0437\u0430 \u043D\u0435\u0434\u0435\u043B\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 829442678054939
    m_Localized: "\u041D\u0430 \u044D\u0442\u043E\u0439 \u043D\u0435\u0434\u0435\u043B\u0435 \u043D\u0435\u0442 \u0432\u044B\u0440\u0443\u0447\u043A\u0438. \u0414\u0435\u043D\u044C\u0433\u0438 \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u0441 \u043F\u0440\u043E\u0434\u0430\u0436: \u043E\u0442\u043A\u0440\u043E\u0439 \u043F\u043B\u0430\u043D \u043D\u0435\u0434\u0435\u043B\u0438 \u0438 \u043E\u0442\u0434\u0430\u0439 \u0432\u0440\u0435\u043C\u044F \u043E\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u0435\u043C\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 829442678054940
    m_Localized: "\u0423\u0431\u044B\u0442\u043E\u043A: \u0440\u0430\u0441\u0445\u043E\u0434\u044B \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u044B\u0440\u0443\u0447\u043A\u0438. \u041E\u0442\u043A\u0440\u043E\u0439 \u043F\u043E\u043B\u043D\u044B\u0439 \u043E\u0442\u0447\u0451\u0442 \u0438 \u043D\u0430\u0439\u0434\u0438 \u0441\u0430\u043C\u0443\u044E \u0431\u043E\u043B\u044C\u0448\u0443\u044E \u0441\u0442\u0430\u0442\u044C\u044E \u0440\u0430\u0441\u0445\u043E\u0434\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 829442678054941
    m_Localized: "\u041F\u0440\u0438\u0431\u044B\u043B\u044C \u0435\u0441\u0442\u044C, \u0430 \u0434\u0435\u043D\u0435\u0433 \u0441\u0442\u0430\u043B\u043E \u043C\u0435\u043D\u044C\u0448\u0435: \u0438\u0437 \u043D\u0435\u0451 \u043E\u043F\u043B\u0430\u0447\u0435\u043D\u044B \u043B\u0438\u0447\u043D\u044B\u0435 \u0440\u0430\u0441\u0445\u043E\u0434\u044B, \u043F\u043E\u043A\u0443\u043F\u043A\u0438 \u0438 \u043F\u043B\u0430\u0442\u0435\u0436\u0438 \u043F\u043E \u043A\u0440\u0435\u0434\u0438\u0442\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 829442678054942
    m_Localized: "\u041F\u0440\u0438\u0431\u044B\u043B\u044C \u2014 \u044D\u0442\u043E \u0442\u043E, \u0447\u0442\u043E \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043F\u043E\u0441\u043B\u0435 \u0432\u0441\u0435\u0445 \u0440\u0430\u0441\u0445\u043E\u0434\u043E\u0432. \u0427\u0430\u0441\u0442\u044C \u043E\u0441\u0442\u0430\u0432\u044C \u0432 \u0440\u0435\u0437\u0435\u0440\u0432\u0435, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435 \u043F\u0443\u0441\u0442\u044C \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
