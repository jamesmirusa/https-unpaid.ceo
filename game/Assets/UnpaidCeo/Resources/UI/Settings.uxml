<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:ScrollView name="settings" class="screen screen--panel">
        <ui:Label name="settings-title" class="screen__title" />
        <ui:Label name="settings-language-caption" class="section-title" />
        <ui:VisualElement name="settings-language" class="choice-row" />
        <ui:Label name="settings-graphics-caption" class="section-title" />
        <ui:VisualElement name="settings-graphics" class="choice-row" />
        <ui:Label name="settings-theme-caption" class="section-title" />
        <ui:VisualElement name="settings-theme" class="choice-row" />
        <ui:Button name="settings-reset" class="danger-button" />
        <ui:Label name="settings-reset-confirm" class="hint" />
    </ui:ScrollView>
</ui:UXML>
