<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="hero-creator" class="hero-creator safe-bottom">
        <ui:Label name="hero-title" class="screen__title" />
        <ui:Label name="hero-species-caption" class="section-title" />
        <ui:VisualElement name="hero-species" class="choice-row" />
        <ui:Label name="hero-outfit-caption" class="section-title" />
        <ui:VisualElement name="hero-outfit" class="choice-row" />
        <ui:Label name="hero-color-caption" class="section-title" />
        <ui:VisualElement name="hero-color" class="choice-row" />
        <ui:Button name="hero-done" class="primary-button" />
    </ui:VisualElement>
</ui:UXML>
