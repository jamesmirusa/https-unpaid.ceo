<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:ScrollView name="decisions" class="screen screen--panel">
        <ui:Label name="decisions-title" class="screen__title" />
        <ui:Label name="time-title" class="section-title" />
        <ui:VisualElement name="time-control" />
        <ui:Label name="business-title" class="section-title" />
        <ui:VisualElement name="business-controls" />
        <ui:Label name="split-title" class="section-title" />
        <ui:VisualElement name="split-control" />
        <ui:Label name="actions-title" class="section-title" />
        <ui:VisualElement class="row">
            <ui:Label name="ap-caption" class="row__label" />
            <ui:Label name="ap-value" class="row__value value" />
        </ui:VisualElement>
        <ui:VisualElement name="actions" />
    </ui:ScrollView>
</ui:UXML>
