<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:ScrollView name="decisions" class="screen screen--panel">
        <ui:Label name="decisions-title" class="screen__title" />
        <ui:Label name="decisions-hint" class="hint" />
        <ui:VisualElement class="visit__budget">
            <ui:Label name="energy-caption" class="visit__budget-caption" />
            <ui:Label name="week-energy" class="visit__budget-value value" />
            <ui:Label name="ap-caption" class="visit__budget-caption" />
            <ui:Label name="ap-value" class="visit__budget-value value" />
        </ui:VisualElement>
        <ui:Label name="mode-title" class="section-title" />
        <ui:VisualElement name="mode-cards" class="week__cards" />
        <ui:Label name="focus-title" class="section-title" />
        <ui:VisualElement name="focus-cards" class="week__cards" />
        <ui:Label name="owner-time" class="hint" />
        <ui:Label name="actions-title" class="section-title" />
        <ui:VisualElement name="actions" />
        <ui:Label name="business-title" class="section-title" />
        <ui:VisualElement name="business-controls" />
    </ui:ScrollView>
</ui:UXML>
