<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:ScrollView name="industry" class="screen screen--panel">
        <ui:Label name="industry-title" class="screen__title" />
        <ui:Label name="industry-hint" class="hint" />
        <ui:VisualElement name="industry-offer" class="industry-offer" />
        <ui:VisualElement name="industry-cards" />
        <ui:Label name="industry-disclaimer" class="disclaimer" />
    </ui:ScrollView>
</ui:UXML>
