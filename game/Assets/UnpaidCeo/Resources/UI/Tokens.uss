:root, .app, .dialogue { -unity-font-definition: url("Fonts/Inter-Regular-SDF.asset"); }
/* Layout tokens and components. Sizes are for the 1080×1920 reference panel. */
/* On a wide (desktop) screen the phone layout stays a phone-wide column in the middle; the city shows on both sides. */
.app {
    flex-grow: 1;
    width: 100%;
    max-width: 1080px;
    align-self: center;
    color: var(--text);
    font-size: 34px;
}
.app Label, .app Button { color: var(--text); }

/* HUD (stage 5B): a floating navy card — money and week pills, icon buttons, the hero's stats row. */
.hud { flex-direction: column; margin: 12px 16px 0 16px; padding: 14px 18px 16px 18px; background-color: var(--chrome); border-radius: 44px; border-width: 2px; border-color: var(--chrome-edge); border-top-color: var(--chrome-highlight); }
.hud__top { flex-direction: row; align-items: center; }
.hud__pill { flex-direction: row; align-items: center; height: 84px; padding: 0 28px 0 12px; margin-right: 14px; border-radius: 46px; background-color: var(--chrome-2); }
.hud__pill-icon { width: 70px; height: 70px; margin-right: 10px; }
.hud__pill-text { flex-direction: column; justify-content: center; }
.hud__block { flex-direction: column; margin-right: 28px; }
.hud__caption { font-size: 22px; color: var(--chrome-dim); }
.hud__value { font-size: 44px; -unity-font-style: bold; color: var(--money-on-chrome); margin-top: -4px; }
.hud__value--plain { color: var(--on-chrome); }
.hud__spacer { flex-grow: 1; }
.hud__stats { flex-direction: row; flex-wrap: wrap; margin-top: 10px; }
.hud__stat { width: 50%; padding-right: 22px; }
.hud__stat-icon { width: 38px; height: 38px; margin-right: 8px; }
.hud__stat-caption { flex-grow: 1; font-size: 24px; -unity-font-style: bold; }
.energy-bar { height: 16px; margin-top: 8px; background-color: var(--chrome-track); border-radius: 8px; overflow: hidden; }
.energy-bar__fill { height: 100%; background-color: var(--energy); border-radius: 8px; transition-property: width; transition-duration: 0.3s; transition-timing-function: ease-out; }
.hud__caption-row { flex-direction: row; align-items: center; }
.hud__energy-value { margin-left: 8px; font-size: 24px; -unity-font-style: bold; }
.app .hud__energy-value { color: var(--on-chrome); }
.icon-button { width: 132px; height: 100px; margin: 0 0 0 12px; padding: 0 0 10px 0; border-radius: 30px; border-width: 0; border-bottom-width: 6px; border-bottom-color: var(--chrome-lip); background-color: var(--chrome-2); font-size: 18px; -unity-font-style: bold; -unity-text-align: lower-center; white-space: nowrap; }
.app .icon-button { color: var(--chrome-dim); }
.icon-button .icon { -unity-background-image-tint-color: var(--on-chrome); width: 46px; height: 46px; top: 12px; }

/* Screens */
.content { flex-grow: 1; }
.screen { position: absolute; left: 0; right: 0; top: 0; bottom: 0; padding: 24px; }
/* Opaque: a popup lies over the city's widgets, and a see-through panel let the guide's text show through the lists. */
.screen--panel { left: 16px; right: 16px; top: 16px; bottom: 16px; background-color: var(--ground); border-radius: 44px; border-width: 2px; border-color: var(--card-edge); border-top-color: var(--card-highlight); scale: 0.94 0.94; opacity: 0; transition-property: scale, opacity; transition-duration: 0.25s, 0.16s; transition-timing-function: ease-out-back, ease-out; }
.screen--panel.popup--in { scale: 1 1; opacity: 1; }
.screen__title { font-size: 54px; -unity-font-style: bold; margin-bottom: 16px; }
.section-title { font-size: 36px; -unity-font-style: bold; margin-top: 24px; margin-bottom: 8px; }
.hint { font-size: 30px; color: var(--text-dim); white-space: normal; }
.city__hint { align-self: center; padding: 10px 24px; background-color: var(--panel); border-radius: 24px; font-size: 30px; }
.disclaimer { font-size: 26px; color: var(--text-dim); white-space: normal; margin-top: 20px; }

/* Rows */
.row { flex-direction: row; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom-width: 1px; border-bottom-color: var(--track); }
.row__label { flex-shrink: 1; }
.row__value { -unity-text-align: middle-right; -unity-font-style: bold; }
.row--total .row__label, .row--total .row__value { font-size: 38px; -unity-font-style: bold; }
.value--negative { color: var(--negative); }
.value--positive { color: var(--positive); }
.pnl-chart { height: 340px; margin: 12px 0 20px 0; }

/* Primary action and navigation */
.primary-button { height: 128px; margin: 0 24px 16px 24px; border-radius: 40px; border-width: 0; border-top-width: 3px; border-top-color: var(--accent-highlight); border-bottom-width: 10px; border-bottom-color: var(--accent-lip); background-color: var(--accent); font-size: 44px; -unity-font-style: bold; }
.app .primary-button { color: var(--on-accent); }
.bottom-nav { flex-direction: row; height: 160px; margin: 0 16px 16px 16px; padding: 10px; background-color: var(--chrome); border-radius: 52px; border-width: 2px; border-color: var(--chrome-edge); border-top-color: var(--chrome-highlight); }
.nav-button { flex-grow: 1; flex-basis: 0; margin: 0 4px; padding: 0 2px 16px 2px; border-width: 0; border-radius: 40px; background-color: rgba(0, 0, 0, 0); font-size: 24px; -unity-text-align: lower-center; transition-property: translate, background-color; transition-duration: 0.18s; transition-timing-function: ease-out-back; }
.nav-button .icon { top: 20px; width: 58px; height: 58px; -unity-background-image-tint-color: var(--chrome-dim); }
.app .nav-button { color: var(--chrome-dim); }
.app .nav-button--active { color: var(--on-chrome); -unity-font-style: bold; translate: 0 -10px; }
.nav-button--active .icon { -unity-background-image-tint-color: var(--accent); }
.nav-badge { position: absolute; top: 8px; right: 14%; min-width: 44px; height: 44px; padding: 0 10px; border-radius: 22px; border-width: 4px; border-color: var(--chrome); background-color: var(--badge); font-size: 22px; -unity-font-style: bold; -unity-text-align: middle-center; }
.nav-badge--dot { min-width: 28px; width: 28px; height: 28px; padding: 0; top: 16px; right: 26%; background-color: var(--accent); }
.app .nav-badge { color: #FFFFFF; }

/* Decisions */
.share-row { flex-direction: row; align-items: center; height: 72px; }
.share-row__label { width: 260px; }
.share-row__slider { flex-grow: 1; margin: 0 16px; }
.share-row__value { width: 110px; -unity-text-align: middle-right; -unity-font-style: bold; }
.action-row { flex-direction: row; align-items: center; height: 72px; }
.action-row__label { flex-grow: 1; }
.action-row__cost { width: 90px; -unity-text-align: middle-right; color: var(--text-dim); }

/* Journal */
.journal-entry { flex-direction: row; padding: 10px 0; border-bottom-width: 1px; border-bottom-color: var(--track); }
.journal-entry__month-caption { font-size: 24px; color: var(--text-dim); }
.journal-entry__month { width: 70px; font-size: 24px; color: var(--text-dim); -unity-text-align: upper-right; margin-right: 16px; }
.journal-entry__text { flex-shrink: 1; flex-grow: 1; white-space: normal; }

/* Settings */
.choice-row { flex-direction: row; flex-wrap: wrap; margin-bottom: 8px; }
.choice-button { padding: 14px 28px; margin: 6px 12px 6px 0; border-radius: 24px; border-width: 2px; border-color: var(--track); background-color: var(--panel-strong); font-size: 32px; }
.choice-button--selected { border-color: var(--accent); -unity-font-style: bold; }
.danger-button { margin-top: 32px; padding: 16px 28px; border-radius: 24px; border-width: 0; background-color: var(--negative); font-size: 32px; align-self: flex-start; }
.app .danger-button { color: #FFFFFF; }

/* Academy */
.academy__list { max-height: 420px; }
.academy__item { padding: 14px 20px; margin: 4px 0; border-radius: 20px; border-width: 0; background-color: var(--panel-strong); -unity-text-align: middle-left; }
.academy__item--selected { -unity-font-style: bold; border-left-width: 8px; border-left-color: var(--accent); }
.academy__item--locked { opacity: 0.45; }
.academy__lesson-title { font-size: 44px; -unity-font-style: bold; margin-top: 16px; white-space: normal; }
.academy__lesson-body { white-space: normal; margin: 12px 0; }
.academy__quiz-title { font-size: 36px; -unity-font-style: bold; margin-top: 16px; }
.academy__question { margin: 12px 0; }
.academy__question-text { white-space: normal; margin-bottom: 6px; }
.academy__option { padding: 12px 20px; margin: 4px 0; border-radius: 18px; border-width: 2px; border-color: var(--track); background-color: var(--panel-strong); white-space: normal; -unity-text-align: middle-left; }
.academy__option--correct { border-color: var(--positive); }
.academy__option--wrong { border-color: var(--negative); }
.academy__feedback { -unity-font-style: bold; white-space: normal; margin-top: 8px; }

/* Yarn dialogue (UitkDialoguePresenter) */
.dialogue-backdrop { position: absolute; left: 0; right: 0; top: 0; bottom: 0; padding: 0 24px; justify-content: flex-end; align-items: center; background-color: rgba(10, 12, 20, 0.5); }
.dialogue { width: 100%; max-width: 1032px; margin: 0 0 220px 0; padding: 28px; border-radius: 32px; background-color: var(--panel); border-width: 4px; border-color: var(--accent); }
.dialogue Label, .dialogue Button { color: var(--text); }
.dialogue__speaker { font-size: 32px; -unity-font-style: bold; color: var(--accent); }
.dialogue__text { white-space: normal; font-size: 36px; margin: 8px 0 16px 0; }
.dialogue__option { padding: 20px 24px; margin: 8px 0; border-radius: 22px; border-width: 2px; border-color: var(--accent); background-color: var(--panel-strong); font-size: 34px; white-space: normal; -unity-text-align: middle-left; }
.dialogue__continue { height: 110px; margin: 8px 0 0 0; border-radius: 28px; border-width: 0; background-color: var(--accent); font-size: 40px; -unity-font-style: bold; }
.dialogue .dialogue__continue { color: var(--on-accent); }

/* Hero creator */
.hero-creator { position: absolute; left: 16px; right: 16px; bottom: 16px; padding: 24px 24px 8px 24px; background-color: var(--panel-strong); border-radius: 32px; }
.swatch { width: 80px; height: 80px; margin: 6px 16px 6px 0; border-radius: 40px; border-width: 5px; border-color: var(--track); }
.swatch--selected { border-color: var(--accent); }

/* Onboarding coach marks */
/* Full-screen layers reach past the column: transparent side borders carry the background to the screen's edges,
   while children (also absolute ones) stay inside the column. */
.onboarding-overlay { position: absolute; left: -4000px; right: -4000px; border-left-width: 4000px; border-right-width: 4000px; border-color: rgba(0, 0, 0, 0); top: 0; bottom: 0; justify-content: center; background-color: rgba(16, 21, 33, 0.3); }
/* (light: the hero being created stands in the city behind this layer) */
.coach { position: absolute; left: 32px; right: 32px; bottom: 300px; padding: 32px 8px 8px 8px; border-radius: 32px; background-color: var(--panel); border-width: 4px; border-color: var(--accent); }
.coach__speaker { margin: 0 32px 8px 32px; font-size: 32px; -unity-font-style: bold; color: var(--accent); }
.coach__text { margin: 0 32px 24px 32px; font-size: 40px; white-space: normal; color: var(--text); }
.app .coach-target { border-width: 8px; border-color: #FFD24A; scale: 1.04 1.04; }

/* Daily turns and missions (stage 2A) */
.turns-bar { flex-direction: row; justify-content: center; align-items: center; margin: 0 24px 8px 24px; }
.turns-bar__caption { font-size: 28px; color: var(--text-dim); margin-right: 8px; }
.turns-bar__value { font-size: 30px; -unity-font-style: bold; margin-right: 24px; }
.turns-bar__wait { flex-direction: row; align-items: center; }
.primary-button:disabled { opacity: 0.45; }
.missions { margin-top: 12px; padding: 8px 24px; background-color: var(--panel); border-radius: 24px; }
.missions__title { font-size: 30px; -unity-font-style: bold; margin-bottom: 4px; }
.missions__toggle { flex-direction: row; align-items: center; margin: 0; padding: 8px 0; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.missions__toggle .missions__title { flex-grow: 1; margin-bottom: 0; -unity-text-align: middle-left; }
.missions__count { font-size: 30px; -unity-font-style: bold; }
.mission .row__label { font-size: 28px; white-space: normal; }
.mission .row__value { font-size: 28px; }
.mission--done .row__label, .mission--done .row__value { color: var(--text-dim); }
.missions__footer { flex-direction: row; align-items: center; margin-top: 8px; }
.missions__caption { font-size: 26px; color: var(--text-dim); margin-right: 6px; }
.missions__value { font-size: 26px; -unity-font-style: bold; margin-right: 20px; }

/* Chapters 2-3 (stage 2A): chapter goal bar, industry cards, steppers, loan dialog, chapter card */
.chapter-bar { margin: 8px 24px 0 24px; padding: 10px 20px 12px 20px; background-color: var(--panel); border-radius: 24px; }
.chapter-bar__goal { flex-direction: row; align-items: center; margin-bottom: 8px; }
.chapter-bar__row { flex-direction: row; align-items: center; }
.chapter-bar__caption { flex-shrink: 1; font-size: 26px; white-space: normal; }
.chapter-bar__goal-value { margin-left: 10px; font-size: 28px; -unity-font-style: bold; color: var(--money); }
.chapter-bar__track { flex-grow: 1; height: 14px; border-radius: 7px; background-color: var(--track); overflow: hidden; }
.chapter-bar__fill { height: 100%; width: 0; background-color: var(--accent); border-radius: 7px; }
.chapter-bar__advance { margin-left: 12px; height: 56px; padding: 0 20px; border-radius: 28px; border-width: 0; background-color: var(--accent); font-size: 26px; -unity-font-style: bold; }
.app .chapter-bar__advance { color: var(--on-accent); }
.industry-card { padding: 20px 24px; margin-bottom: 20px; background-color: var(--panel); border-radius: 28px; }
.industry-card--chosen { border-width: 4px; border-color: var(--accent); }
.industry-card__name { font-size: 38px; -unity-font-style: bold; white-space: normal; }
.industry-card__scale { flex-direction: row; flex-wrap: wrap; margin: 4px 0 8px 0; }
.industry-card__step { font-size: 24px; color: var(--text-dim); margin-right: 16px; white-space: normal; }
.industry-card__lesson { flex-shrink: 1; -unity-text-align: middle-right; white-space: normal; }
.industry-card__choose { margin: 12px 0 0 0; height: 96px; }
.industry-offer { padding: 20px 24px; margin-bottom: 20px; background-color: var(--panel); border-radius: 28px; }
.industry-offer__text { white-space: normal; margin-bottom: 8px; }
.industry-offer__capex { -unity-text-align: middle-center; }
.business-box { padding: 12px 0; border-bottom-width: 1px; border-bottom-color: var(--track); }
.business-box__name { font-size: 34px; -unity-font-style: bold; white-space: normal; }
.stepper__button { width: 80px; height: 72px; margin: 0 8px; border-radius: 24px; font-size: 40px; -unity-font-style: bold; }
.stepper__value { width: 80px; -unity-text-align: middle-center; font-size: 36px; -unity-font-style: bold; }
.decisions__warning { color: var(--negative); white-space: normal; font-size: 26px; }
.modal { position: absolute; left: -4000px; right: -4000px; border-left-width: 4000px; border-right-width: 4000px; border-color: rgba(0, 0, 0, 0); top: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.55); justify-content: center; }
.modal__panel { margin: 0 32px; padding: 28px 32px; background-color: var(--panel); border-radius: 32px; }
.modal__panel .primary-button { margin: 16px 0 8px 0; }
.modal__panel .danger-button { margin: 0; }
.chapter-card { position: absolute; left: -4000px; right: -4000px; border-left-width: 4000px; border-right-width: 4000px; border-color: rgba(0, 0, 0, 0); top: 0; bottom: 0; background-color: rgba(10, 10, 20, 0.92); justify-content: center; align-items: center; }
.chapter-card__title { font-size: 72px; -unity-font-style: bold; color: rgb(255, 255, 255); white-space: normal; -unity-text-align: middle-center; }
.chapter-card__subtitle { font-size: 34px; color: rgb(220, 220, 230); margin-top: 16px; white-space: normal; -unity-text-align: middle-center; }


/* Ranking (stage 2B) */
.league-name { font-size: 44px; -unity-font-style: bold; margin: 4px 0 12px 0; }
.rank-list { margin-top: 8px; }
.rank-row { flex-direction: row; align-items: center; padding: 10px 16px; margin-bottom: 6px; background-color: var(--panel); border-radius: 18px; }
.rank-row--me { border-width: 3px; border-color: var(--accent); }
.rank-row__rank { width: 90px; font-size: 28px; color: var(--text-dim); }
.rank-row__name { flex-grow: 1; font-size: 28px; }
.rank-row__score { font-size: 28px; -unity-font-style: bold; }
.rank-row__me { font-size: 30px; margin-bottom: 12px; }
.badge-list { flex-direction: row; flex-wrap: wrap; margin-top: 8px; }
.badge { padding: 8px 18px; margin: 0 10px 10px 0; border-radius: 22px; background-color: var(--panel); font-size: 26px; }

/* Account (stage 2B) */
.account__form { margin-top: 8px; }
.account__player { font-size: 32px; -unity-font-style: bold; }
.account__message { margin-top: 8px; }
.text-input { font-size: 30px; margin: 4px 0 10px 0; }

/* Run banner (stage 2B) */
.run-banner { position: absolute; left: 24px; right: 24px; top: 150px; flex-direction: row; flex-wrap: wrap; align-items: center; padding: 10px 18px; background-color: var(--panel); border-radius: 24px; border-width: 3px; border-color: var(--accent); }
.run-banner__title { font-size: 26px; -unity-font-style: bold; margin-right: 12px; }
.run-banner__months { font-size: 26px; flex-grow: 1; }
.run-banner__result { width: 100%; font-size: 26px; white-space: normal; margin: 6px 0; }

/* Friends and duels (stage 2B) */
.friends__name { flex-grow: 1; }
.friend-row, .duel-row { flex-direction: row; flex-wrap: wrap; align-items: center; padding: 10px 16px; margin-bottom: 6px; background-color: var(--panel); border-radius: 18px; }
.friend-row__name, .duel-row__name { flex-grow: 1; font-size: 28px; }
.duel-row__industry { font-size: 24px; color: var(--text-dim); margin-right: 12px; }
.duel-row__state { font-size: 24px; margin-right: 12px; }

/* One main screen: the city with its widgets, popups over it, the month result */
.city-stack { position: absolute; left: 24px; right: 24px; bottom: 16px; }
.guide { margin-top: 12px; padding: 20px 24px; background-color: var(--panel); border-radius: 28px; border-left-width: 12px; border-left-color: var(--accent); }
.guide__text { font-size: 34px; white-space: normal; margin-bottom: 14px; }
.guide__action { height: 92px; margin: 0; border-radius: 26px; border-width: 0; background-color: var(--accent); font-size: 34px; -unity-font-style: bold; }
.app .guide__action { color: var(--on-accent); }
.popup-backdrop { position: absolute; left: -4000px; right: -4000px; top: 0; bottom: 0; background-color: rgba(10, 12, 20, 0.55); }
.popup-close { position: absolute; right: 36px; top: 30px; height: 72px; margin: 0; padding: 0 30px; border-radius: 36px; border-width: 0; background-color: var(--accent); font-size: 30px; -unity-font-style: bold; }
.app .popup-close { color: var(--on-accent); }
.hero-tag { position: absolute; translate: -50% -100%; padding: 4px 20px; border-radius: 22px; background-color: var(--accent); font-size: 28px; -unity-font-style: bold; }
.app .hero-tag { color: var(--on-accent); }
.summary__head { flex-direction: row; align-items: center; margin-bottom: 8px; }
.summary__head .section-title { margin: 0 12px 0 0; font-size: 44px; }
.summary__tip { margin: 20px 0 4px 0; padding: 18px 22px; border-radius: 22px; background-color: var(--panel-strong); font-size: 32px; white-space: normal; }
.link-button { align-self: center; margin: 0; padding: 14px 28px; border-width: 0; background-color: rgba(0, 0, 0, 0); font-size: 30px; }
.app .link-button { color: var(--text-dim); }

/* Text colours with meaning. The base rule (.app Label, .app Button) is stronger than a single class, so every
   colour set by one class above is repeated here with .app in front; keep the two in step. */
.app .hud__caption { color: var(--chrome-dim); }
.app .hud__value { color: var(--money-on-chrome); }
.app .hud__value--plain { color: var(--on-chrome); }
.app .hint { color: var(--text-dim); }
.app .disclaimer { color: var(--text-dim); }
.app .value--negative { color: var(--negative); }
.app .value--positive { color: var(--positive); }
.app .action-row__cost { color: var(--text-dim); }
.app .journal-entry__month-caption { color: var(--text-dim); }
.app .journal-entry__month { color: var(--text-dim); }
.app .coach__text { color: var(--text); }
.app .turns-bar__caption { color: var(--text-dim); }
.app .mission--done .row__label, .app .mission--done .row__value { color: var(--text-dim); }
.app .missions__caption { color: var(--text-dim); }
.app .chapter-bar__goal-value { color: var(--money); }
.app .industry-card__step { color: var(--text-dim); }
.app .decisions__warning { color: var(--negative); }
.app .chapter-card__title { color: rgb(255, 255, 255); }
.app .chapter-card__subtitle { color: rgb(220, 220, 230); }
.app .rank-row__rank { color: var(--text-dim); }
.app .duel-row__industry { color: var(--text-dim); }

/* Pointer states. The default theme greys a hovered, focused or pressed button, which reads as "disabled" on a
   coloured one; these selectors are heavier than the theme's on purpose. */
.app Button.primary-button:hover, .app Button.primary-button:focus, .app Button.primary-button:active,
.app Button.guide__action:hover, .app Button.guide__action:focus, .app Button.guide__action:active,
.app Button.popup-close:hover, .app Button.popup-close:focus, .app Button.popup-close:active,
.app Button.chapter-bar__advance:hover, .app Button.chapter-bar__advance:focus, .app Button.chapter-bar__advance:active,
.dialogue Button.dialogue__continue:hover, .dialogue Button.dialogue__continue:focus, .dialogue Button.dialogue__continue:active { background-color: var(--accent); }
.app Button.nav-button:hover, .app Button.nav-button:focus, .app Button.nav-button:active { background-color: rgba(255, 255, 255, 0.06); }
.app Button.nav-button.nav-button--active, .app Button.nav-button.nav-button--active:hover, .app Button.nav-button.nav-button--active:focus { background-color: var(--accent-soft); }
.app Button.choice-button:hover, .app Button.choice-button:focus, .app Button.academy__item:hover, .app Button.academy__item:focus,
.app Button.academy__option:hover, .app Button.academy__option:focus,
.dialogue Button.dialogue__option:hover, .dialogue Button.dialogue__option:focus { background-color: var(--panel-strong); }
.app Button.choice-button:active, .app Button.academy__item:active,
.app Button.academy__option:active, .dialogue Button.dialogue__option:active { background-color: var(--track); }
.app Button.missions__toggle:hover, .app Button.missions__toggle:focus, .app Button.missions__toggle:active,
.app Button.link-button:hover, .app Button.link-button:focus, .app Button.link-button:active { background-color: rgba(0, 0, 0, 0); }
.app Button.danger-button:hover, .app Button.danger-button:focus, .app Button.danger-button:active { background-color: var(--negative); }
.app Button.icon-button:hover, .app Button.icon-button:focus, .app Button.icon-button:active { background-color: var(--chrome-2); }
.app Button.primary-button:disabled { opacity: 0.45; }

/* Name tags of the block's residents (the hero's own tag is the accent one). */
.npc-tag { position: absolute; translate: -50% -100%; padding: 2px 16px; border-radius: 18px; background-color: var(--panel); font-size: 24px; }

/* Places of the block: the list of cards, a place with its picture and host, and markers over the buildings */
.places__hint { margin-bottom: 20px; }
.place-card { flex-direction: row; align-items: center; height: 200px; margin: 0 0 16px 0; padding: 0; border-width: 0; border-radius: 28px; background-color: var(--panel); overflow: hidden; }
.place-card__thumb { width: 300px; height: 200px; flex-shrink: 0; background-color: var(--track); -unity-background-scale-mode: scale-and-crop; }
.place-card__text { flex-grow: 1; flex-shrink: 1; padding: 0 24px; }
.place-card__title { font-size: 40px; -unity-font-style: bold; -unity-text-align: middle-left; white-space: normal; }
.place-card__host { font-size: 28px; -unity-text-align: middle-left; white-space: normal; }
.place__back { align-self: flex-start; height: 64px; margin: 0 0 12px 0; padding: 0 24px; border-radius: 32px; border-width: 2px; border-color: var(--track); background-color: var(--panel); font-size: 28px; }
.place__art { height: 620px; margin-bottom: 16px; border-radius: 28px; background-color: var(--track); -unity-background-scale-mode: scale-and-crop; }
.place__host { font-size: 30px; margin: -8px 0 14px 0; white-space: normal; }
.place__line { margin-bottom: 14px; padding: 20px 24px; border-radius: 24px; border-left-width: 10px; border-left-color: var(--accent); background-color: var(--panel); font-size: 34px; white-space: normal; }
.place-action { flex-direction: column; align-items: stretch; margin: 8px 0; padding: 18px 24px; border-radius: 24px; border-width: 3px; border-color: var(--track); background-color: var(--panel); }
.place-action:disabled { opacity: 0.45; }
.place-action__label { font-size: 34px; -unity-font-style: bold; white-space: normal; -unity-text-align: middle-left; }
.place-action__chips { flex-direction: row; flex-wrap: wrap; margin-top: 6px; }
.chip { flex-direction: row; align-items: center; margin-right: 22px; }
.chip__caption { font-size: 26px; margin-right: 6px; }
.chip__value { font-size: 28px; -unity-font-style: bold; }
.place-marker { position: absolute; translate: -50% -100%; flex-direction: column; align-items: center; width: 210px; margin: 0; padding: 8px 8px 6px 8px; border-radius: 22px; border-width: 3px; border-color: var(--accent); background-color: var(--card); font-size: 26px; -unity-font-style: bold; white-space: normal; -unity-text-align: middle-center; }
.place-marker__pic { width: 190px; height: 112px; margin-bottom: 4px; border-radius: 14px; background-color: var(--track); -unity-background-scale-mode: scale-and-crop; }
.place-marker__title { font-size: 26px; -unity-font-style: bold; white-space: normal; -unity-text-align: middle-center; }
.app .place-card__host, .app .place__host, .app .chip__caption { color: var(--text-dim); }
.app .chip__value.value--positive { color: var(--positive); }
.app .chip__value.value--negative { color: var(--negative); }
.app Button.place-card:hover, .app Button.place-card:focus, .app Button.place-card:active,
.app Button.place-action:hover, .app Button.place-action:focus, .app Button.place-action:active,
.app Button.place__back:hover, .app Button.place__back:focus, .app Button.place__back:active { background-color: var(--panel); }
.app Button.place-marker:hover, .app Button.place-marker:focus, .app Button.place-marker:active { background-color: var(--panel-strong); }
.app Button.place-card:active, .app Button.place-action:active, .app Button.place-marker:active { opacity: 0.8; }

/* The city clips its name tags and markers to its own area: nothing of it is drawn over the HUD or the chapter bar. */
#city { overflow: hidden; }


/* Stage 4 · the checklist before "Next month": each line opens the screen where it is done. */
.gate { margin-top: 12px; padding: 16px 24px 8px 24px; background-color: var(--panel); border-radius: 28px; }
.gate__title { font-size: 28px; -unity-font-style: bold; margin-bottom: 6px; }
.gate__item { flex-direction: row; align-items: center; height: 76px; margin: 0 0 8px 0; padding: 0 12px 0 6px; border-radius: 20px; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.gate__check { width: 44px; height: 44px; margin-right: 14px; border-radius: 22px; border-width: 3px; border-color: var(--text-dim); font-size: 28px; -unity-font-style: bold; -unity-text-align: middle-center; flex-shrink: 0; }
.gate__item--done .gate__check { border-color: var(--accent); background-color: var(--accent); }
.gate__text { flex-grow: 1; flex-shrink: 1; font-size: 30px; white-space: normal; -unity-text-align: middle-left; }
.gate__count { font-size: 30px; -unity-font-style: bold; margin-left: 12px; }
.app .gate__item--done .gate__text { color: var(--text-dim); }
.app .gate__item--done .gate__check { color: var(--on-accent); }
.app Button.gate__item:hover, .app Button.gate__item:focus { background-color: var(--panel-strong); }
.app Button.gate__item:active { background-color: var(--track); }

/* Stage 4 · a living scene: what the choice did, under the line. */
.dialogue__consequences { flex-direction: row; flex-wrap: wrap; margin: 0 0 14px 0; padding: 10px 16px; border-radius: 18px; background-color: var(--panel-strong); }
.dialogue .chip__caption { color: var(--text-dim); }
.dialogue .chip__value.value--positive { color: var(--positive); }
.dialogue .chip__value.value--negative { color: var(--negative); }

/* Stage 4B · the week's result: what was paid and what falls due next week. */
.summary__section { margin-top: 10px; padding: 12px 18px; border-radius: 18px; background-color: var(--panel-strong); }
.summary__section-title { font-size: 26px; -unity-font-style: bold; margin-bottom: 4px; }
.summary__item { flex-direction: row; justify-content: space-between; padding: 3px 0; }
.summary__item-caption { font-size: 28px; }
.summary__item-value { font-size: 28px; -unity-font-style: bold; }
.app .summary__item-caption { color: var(--text-dim); }

/* Everything by button: the strip of places over the city and the camera buttons. */
.strip { position: absolute; left: 0; right: 0; top: 8px; height: 190px; padding: 0 8px; }
.strip #unity-content-container { flex-direction: row; align-items: flex-start; }
.strip__item { flex-direction: column; align-items: center; width: 150px; height: 174px; margin: 0 6px; padding: 6px; border-radius: 20px; border-width: 3px; border-color: rgba(0, 0, 0, 0); background-color: var(--panel); }
.strip__item--focused { border-color: var(--accent); background-color: var(--card); }
.strip__pic { width: 134px; height: 90px; border-radius: 12px; background-color: var(--track); -unity-background-scale-mode: scale-and-crop; }
.strip__title { margin-top: 4px; font-size: 22px; -unity-font-style: bold; white-space: normal; -unity-text-align: upper-center; }
.camera-buttons { position: absolute; right: 12px; top: 206px; flex-direction: row; }
.camera-button { width: 80px; height: 80px; margin: 0 0 0 8px; padding: 0; border-radius: 42px; border-width: 3px; border-color: var(--track); background-color: var(--panel); font-size: 36px; -unity-font-style: bold; }
#city-home { width: auto; min-width: 84px; padding: 0 18px; font-size: 24px; }
.app Button.strip__item:hover, .app Button.strip__item:focus, .app Button.strip__item:active { background-color: var(--card); }
.app Button.camera-button:hover, .app Button.camera-button:focus { background-color: var(--panel-strong); border-color: var(--accent); }
.app Button.camera-button:active { background-color: var(--track); }

/* Inside a place: the 3D room above, the conversation below; the street's widgets step aside. */
.visiting #city-strip, .visiting .camera-buttons, .visiting .city-stack, .visiting #next-month, .visiting .bottom-nav,
.visiting .chapter-bar, .visiting .guide { display: none; }
.visiting .turns-bar { visibility: hidden; }
.visit { position: absolute; left: 12px; right: 12px; bottom: 12px; padding: 20px 22px 16px 22px; border-radius: 30px; border-width: 4px; border-color: var(--accent); background-color: var(--card); }
.visit__head { flex-direction: row; align-items: center; margin-bottom: 10px; }
.visit__portrait { width: 132px; height: 88px; border-radius: 16px; margin-right: 16px; background-color: var(--track); -unity-background-scale-mode: scale-and-crop; }
.visit__names { flex-grow: 1; flex-shrink: 1; }
.visit__speaker { font-size: 36px; -unity-font-style: bold; }
.visit__place { font-size: 26px; }
.visit__line { font-size: 34px; white-space: normal; margin: 4px 0 12px 0; padding: 14px 18px; border-radius: 20px; border-left-width: 8px; border-left-color: var(--accent); background-color: var(--panel); }
.visit__consequences { flex-direction: row; flex-wrap: wrap; margin: 0 0 10px 0; padding: 8px 14px; border-radius: 16px; background-color: var(--panel-strong); }
.visit__choices { margin-bottom: 6px; }
.visit__choice { flex-direction: column; align-items: stretch; margin: 6px 0; padding: 14px 20px; border-radius: 22px; border-width: 3px; border-color: var(--track); background-color: var(--panel); }
.visit__choice--planned { border-color: var(--accent); background-color: var(--panel-strong); }
.visit__choice:disabled { opacity: 0.45; }
.visit__choice-label { font-size: 32px; -unity-font-style: bold; white-space: normal; -unity-text-align: middle-left; }
.visit__choice-chips { flex-direction: row; flex-wrap: wrap; margin-top: 4px; }
.visit__choice-status { font-size: 24px; margin-top: 4px; -unity-font-style: bold; white-space: normal; -unity-text-align: middle-left; color: var(--text-dim); }
.visit__choice--recommended { border-color: var(--energy); }
.visit__choice--recommended .visit__choice-status { color: var(--energy); }
.visit__choice--planned .visit__choice-status { color: var(--accent); }
/* A done choice is closed but not greyed: it reads as done, a blocked one reads as unavailable. */
.visit__choice--planned:disabled { opacity: 1; }
/* Stage 5A · the Week screen: one-tap cards (mode, where the work goes) and one-step lever buttons, closed until next week. */
.week__cards { flex-direction: row; flex-wrap: wrap; justify-content: space-between; margin-bottom: 4px; }
.week-card { width: 49%; flex-direction: column; align-items: stretch; margin: 6px 0; padding: 16px 18px; border-radius: 22px; border-width: 3px; border-color: var(--track); background-color: var(--panel); }
.week-card--small { padding: 12px 18px; }
.week-card--selected { border-color: var(--accent); background-color: var(--panel-strong); }
.week-card:disabled { opacity: 0.45; }
.week-card--selected:disabled { opacity: 1; }
.week-card__title { font-size: 30px; -unity-font-style: bold; white-space: normal; -unity-text-align: middle-left; }
.week-card__desc { font-size: 22px; white-space: normal; -unity-text-align: middle-left; margin-top: 2px; }
.week-card__status-row { flex-direction: row; flex-wrap: wrap; align-items: center; }
.week-card__status { font-size: 22px; margin: 6px 6px 0 0; -unity-font-style: bold; white-space: normal; -unity-text-align: middle-left; }
.app .week-card__desc { color: var(--text-dim); }
.app .week-card__status { color: var(--text-dim); }
.app .week-card--selected .week-card__status { color: var(--accent); }
/* Pointer over an open card: the same hover as the room cards, not the default theme's grey (desktop web). */
.app Button.week-card:hover:enabled { background-color: var(--panel-strong); border-color: var(--accent); }
.lever-row { flex-direction: row; margin: 2px 0 10px 0; }
.lever-button { flex-grow: 1; flex-basis: 0; height: 72px; margin: 0 4px; border-radius: 20px; border-width: 3px; border-color: var(--accent); background-color: var(--card); font-size: 24px; -unity-font-style: bold; white-space: normal; }
.lever-button:disabled { opacity: 0.4; }
.app Button.lever-button:hover, .app Button.lever-button:focus { background-color: var(--panel-strong); }
.app Button.lever-button:active { background-color: var(--track); }
/* The default theme paints a disabled button grey and dims its text (.unity-button:disabled); a card closed for the week
   keeps its own colours: a taken one stays bright with its accent frame, the others only fade. */
.app .week-card:disabled, .app .visit__choice:disabled { background-color: var(--panel); border-color: var(--track); }
.app .week-card--selected:disabled, .app .visit__choice--planned:disabled { background-color: var(--panel-strong); border-color: var(--accent); color: var(--text); }
.app .lever-button:disabled { background-color: var(--card); border-color: var(--accent); }
.app Button.lever-button.lever-button--taken:disabled { opacity: 1; background-color: var(--accent); border-color: var(--accent); color: var(--on-accent); }
/* "Sure?": a step that cannot be undone waits for its second tap in the warning colour. These beat the hover/focus/active
   paint (a button disabled during its own tap can keep :active). */
.app Button.lever-button.lever-button--armed, .app Button.visit__choice.visit__choice--armed { border-color: var(--negative); }
.app Button.lever-button.lever-button--armed { color: var(--negative); background-color: var(--card); }
.app .visit__choice--armed .visit__choice-status { color: var(--negative); }
.lever-status { font-size: 22px; margin: -4px 4px 10px 4px; white-space: normal; -unity-font-style: bold; }
.app .lever-status { color: var(--text-dim); }
.visit__budget { flex-direction: row; align-items: center; flex-wrap: wrap; margin: 0 0 6px 0; }
.visit__budget-caption { font-size: 24px; margin-right: 6px; color: var(--text-dim); }
.visit__budget-value { font-size: 26px; margin-right: 22px; -unity-font-style: bold; }
.visit__row { flex-direction: row; margin-top: 6px; }
.visit__talk, .visit__exit { flex-grow: 1; flex-basis: 0; height: 84px; margin: 0 6px 0 0; border-radius: 26px; font-size: 30px; -unity-font-style: bold; }
.visit__talk { border-width: 3px; border-color: var(--accent); background-color: var(--card); }
.visit__exit { margin: 0 0 0 6px; border-width: 0; background-color: var(--accent); }
.app .visit__place { color: var(--text-dim); }
.app .visit__exit { color: var(--on-accent); }
.app Button.visit__choice:hover, .app Button.visit__choice:focus { background-color: var(--panel-strong); border-color: var(--accent); }
.app Button.visit__choice:active { background-color: var(--track); }
.app Button.visit__talk:hover, .app Button.visit__talk:focus, .app Button.visit__talk:active { background-color: var(--panel-strong); }
.app Button.visit__exit:hover, .app Button.visit__exit:focus, .app Button.visit__exit:active { background-color: var(--accent); }
.fade { position: absolute; left: -4000px; right: -4000px; top: 0; bottom: 0; background-color: rgb(8, 9, 16); }

/* ===== Stage 5B · UI kit and game feel ===== */
/* Icons: service icons are white and tinted here; game icons keep their colours. Neither takes taps. */
.icon { width: 44px; height: 44px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: var(--text); }
.game-icon { width: 64px; height: 64px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.icon--top { position: absolute; top: 14px; left: 50%; translate: -50% 0; }
.icon--lead { position: absolute; left: 26px; top: 50%; translate: 0 -50%; }
.has-icon--lead { padding-left: 92px; }
.icon--trail { position: absolute; right: 40px; top: 50%; translate: 0 -50%; width: 52px; height: 52px; }
.primary-button .icon { -unity-background-image-tint-color: var(--on-accent); }
/* A coloured tile with a game icon on the left of a card (deeds, modes). */
.icon--tile { position: absolute; left: 18px; top: 18px; width: 104px; height: 104px; padding: 14px; border-radius: 30px; background-color: var(--tile); border-bottom-width: 5px; border-bottom-color: var(--card-lip); }
.has-icon--tile { padding-left: 140px; min-height: 140px; }

/* Volume: cards stand on a darker lip, panels float on a soft shadow (9-slice sprite, Kit/Shadow.cs). */
.drop-shadow { background-image: url("Kit/shadow.png"); -unity-slice-left: 72; -unity-slice-right: 72; -unity-slice-top: 72; -unity-slice-bottom: 72; -unity-background-image-tint-color: rgba(10, 16, 32, 0.55); }
.week-card, .visit__choice, .place-action { border-bottom-width: 9px; border-bottom-color: var(--card-lip); background-color: var(--card-face); }
.screen--panel .week-card, .screen--panel .visit__choice { background-color: var(--card-face); }
.week-card--selected, .visit__choice--planned { border-bottom-color: var(--accent-lip); }
.visit__choice--recommended { border-bottom-color: var(--energy-lip); }
.guide, .gate, .missions, .chapter-bar { border-width: 2px; border-color: var(--card-edge); border-top-color: var(--card-highlight); border-bottom-width: 7px; border-bottom-color: var(--card-lip); }
.guide { border-left-width: 2px; border-left-color: var(--card-edge); }
.guide__action, .visit__exit, .chapter-bar__advance { border-top-width: 2px; border-top-color: var(--accent-highlight); border-bottom-width: 7px; border-bottom-color: var(--accent-lip); }
.popup-close { border-bottom-width: 6px; border-bottom-color: var(--accent-lip); }
.danger-button { border-bottom-width: 7px; border-bottom-color: var(--negative-lip); }
.lever-button { border-bottom-width: 7px; }
.choice-button { border-bottom-width: 6px; border-bottom-color: var(--card-lip); }
.choice-button--selected { border-bottom-color: var(--accent-lip); }

/* Every button answers the touch: it sinks (scale, lip pressed in) and springs back on release (ease-out-back). */
.app Button, .dialogue Button { transition-property: scale, translate, background-color; transition-duration: 0.12s, 0.12s, 0.18s; transition-timing-function: ease-out-back, ease-out-back, ease-out; }
.dialogue Button.feel--pressed { scale: 0.96 0.96; }
.dialogue Button.dialogue__continue.feel--pressed { border-bottom-width: 2px; translate: 0 6px; }
.app Button.feel--pressed { scale: 0.96 0.96; }
.app Button.primary-button.feel--pressed, .app Button.guide__action.feel--pressed, .app Button.visit__exit.feel--pressed,
.app Button.chapter-bar__advance.feel--pressed, .app Button.popup-close.feel--pressed { border-bottom-width: 2px; translate: 0 6px; }
.app Button.week-card.feel--pressed, .app Button.visit__choice.feel--pressed, .app Button.place-action.feel--pressed,
.app Button.lever-button.feel--pressed, .app Button.choice-button.feel--pressed, .app Button.icon-button.feel--pressed { border-bottom-width: 3px; translate: 0 5px; }
.app Button.nav-button.feel--pressed { scale: 0.92 0.92; }

/* The floating change next to a number ("+$51" green, "−10" red): rises, holds, fades. */
.delta { position: absolute; right: -18px; top: 4px; padding: 2px 14px 4px 14px; border-radius: 20px; font-size: 26px; -unity-font-style: bold; transition-property: translate, opacity; transition-duration: 0.9s, 0.45s; transition-delay: 0s, 0.45s; transition-timing-function: ease-out, ease-in; }
.delta--positive { background-color: var(--positive); }
.delta--negative { background-color: var(--negative); }
.delta--fly { translate: 0 -26px; opacity: 0; }
.app .delta { color: #FFFFFF; }

/* Toasts: a short note that slides in at the top for 2 s. */
.toast { position: absolute; top: 36px; left: 72px; right: 72px; min-height: 104px; padding: 22px 32px; border-radius: 40px; background-color: var(--chrome); border-width: 2px; border-color: var(--chrome-edge); border-top-color: var(--chrome-highlight); font-size: 32px; -unity-font-style: bold; white-space: normal; -unity-text-align: middle-left; translate: 0 -60px; opacity: 0; transition-property: translate, opacity; transition-duration: 0.28s, 0.2s; transition-timing-function: ease-out-back, ease-out; }
.toast .game-icon { width: 62px; height: 62px; }
.toast--in { translate: 0 0; opacity: 1; }
.app .toast { color: var(--on-chrome); }

/* Modals (the week result) open with the same bounce as popups. */
.modal__panel { border-width: 2px; border-color: var(--card-edge); border-top-color: var(--card-highlight); border-bottom-width: 9px; border-bottom-color: var(--card-lip); border-radius: 44px; scale: 0.9 0.9; opacity: 0; transition-property: scale, opacity; transition-duration: 0.28s, 0.16s; transition-timing-function: ease-out-back, ease-out; }
.modal__panel.popup--in { scale: 1 1; opacity: 1; }
.toast.has-icon--lead { padding-left: 112px; }
.modal__panel { background-color: var(--card-face); }
.summary__icon { width: 92px; height: 92px; margin-right: 16px; }

/* Week screen: a mode card leads with its game icon; a focus card with a small tinted one. */
.week-card--mode { padding-top: 14px; }
.week-card__icon { width: 84px; height: 84px; margin-bottom: 4px; }
.week-card__title--with-icon { padding-left: 58px; }
.week-card__title--with-icon .icon { left: 0; width: 44px; height: 44px; -unity-background-image-tint-color: var(--text); }
.popup-close.has-icon--lead { width: 250px; padding: 0 30px 0 70px; -unity-text-align: middle-center; }
.popup-close .icon { left: 24px; width: 38px; height: 38px; -unity-background-image-tint-color: var(--on-accent); }
.visit__talk .icon { left: 30px; -unity-background-image-tint-color: var(--text); }
.visit__exit .icon { left: 30px; -unity-background-image-tint-color: var(--on-accent); }

/* Scroll bars: thin rounded thumbs instead of the default grey bar with arrows. */
.app .unity-scroller--vertical { width: 14px; margin: 18px 4px 18px 0; }
.app .unity-scroller--vertical .unity-scroller__low-button, .app .unity-scroller--vertical .unity-scroller__high-button { display: none; }
.app .unity-scroller--vertical .unity-base-slider__tracker { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.app .unity-scroller--vertical .unity-base-slider__dragger { left: 3px; width: 8px; border-radius: 4px; border-width: 0; background-color: var(--card-lip); }
.app .unity-scroller--vertical .unity-base-slider__drag-container { margin: 0; }
.app .unity-scroller--horizontal { height: 0; }
.visit { border-radius: 40px; border-bottom-width: 10px; border-bottom-color: var(--accent-lip); }

/* ===== Stage 5B step 2 · radial menu, badges, calendar ===== */
.radial { position: absolute; left: -4000px; right: -4000px; top: 0; bottom: 0; border-left-width: 4000px; border-right-width: 4000px; border-color: rgba(0, 0, 0, 0); }
.radial__backdrop { position: absolute; left: -4000px; right: -4000px; top: 0; bottom: 0; background-color: rgba(10, 12, 20, 0.45); }
.radial__ring { position: absolute; width: 0; height: 0; scale: 0.7 0.7; opacity: 0; transition-property: scale, opacity; transition-duration: 0.18s, 0.12s; transition-timing-function: ease-out-back, ease-out; }
.radial__ring.popup--in { scale: 1 1; opacity: 1; }
.radial__center { position: absolute; left: -110px; top: -46px; width: 220px; height: 92px; border-radius: 46px; background-color: var(--chrome); border-width: 3px; border-color: var(--accent); justify-content: center; }
.radial__title { font-size: 28px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; }
.app .radial__title { color: var(--on-chrome); }
.radial__petal { position: absolute; width: 190px; height: 190px; margin: 0; padding: 18px 10px 0 10px; border-radius: 95px; border-width: 3px; border-color: var(--card-edge); border-bottom-width: 9px; border-bottom-color: var(--card-lip); background-color: var(--card-face); align-items: center; justify-content: flex-start; }
.radial__icon { width: 84px; height: 84px; }
.radial__petal .icon { -unity-background-image-tint-color: var(--text); width: 72px; height: 72px; margin: 6px 0 6px 0; }
.radial__label { font-size: 21px; -unity-font-style: bold; white-space: normal; -unity-text-align: upper-center; }
.radial__petal--pending { border-color: var(--accent); border-bottom-color: var(--accent-lip); }
.radial__petal--recommended { border-color: var(--energy); border-bottom-color: var(--energy-lip); }
.radial__petal--selected { scale: 1.08 1.08; }
.radial__petal--done { border-color: var(--positive); border-bottom-color: var(--positive-lip); }
.radial__petal--armed { border-color: var(--negative); border-bottom-color: var(--negative-lip); }
.app .radial__petal:disabled { opacity: 0.55; background-color: var(--card-face); border-color: var(--card-edge); }
.app .radial__petal--done:disabled { opacity: 1; border-color: var(--positive); }
.app Button.radial__petal:hover, .app Button.radial__petal:focus { background-color: var(--card-face); }
.app Button.radial__petal:active { background-color: var(--tile); }
.radial__chip-box { position: absolute; left: -330px; top: 360px; width: 660px; padding: 16px 24px; border-radius: 32px; background-color: var(--chrome); border-width: 2px; border-color: var(--chrome-edge); border-top-color: var(--chrome-highlight); align-items: center; }
.radial__chip { font-size: 28px; -unity-font-style: bold; white-space: normal; -unity-text-align: middle-center; }
.app .radial__chip { color: var(--on-chrome); }
.app .radial__chip--closed { color: #FF9A8F; }
.radial__chip-effects { flex-direction: row; flex-wrap: wrap; justify-content: center; margin-top: 6px; }
.radial__chip-effects .chip__caption { color: var(--chrome-dim); }
.app .radial__chip-effects .chip__value.value--positive { color: var(--money-on-chrome); }
.app .radial__chip-effects .chip__value.value--negative { color: #FF9A8F; }

/* Badges over heads and signs ("$" work, "?" lesson): they breathe so they read from afar. */
.emote { position: absolute; left: 50%; top: -92px; width: 84px; height: 84px; translate: -50% 0; -unity-background-scale-mode: scale-to-fit; transition-property: scale; transition-duration: 0.6s; transition-timing-function: ease-in-out; }
.emote--big { scale: 1.14 1.14; }
.place-marker .emote { top: -70px; left: auto; right: -30px; translate: 0 0; width: 76px; height: 76px; }
.npc-tag { padding: 6px 20px; border-radius: 22px; border-width: 2px; border-color: var(--card-edge); border-bottom-width: 5px; border-bottom-color: var(--card-lip); font-size: 26px; -unity-font-style: bold; }
.hero-tag { border-bottom-width: 5px; border-bottom-color: var(--accent-lip); }

/* The month's weeks with their money dates (in the HUD). */
.calendar { margin-top: 12px; }
.calendar__head { flex-direction: row; align-items: center; margin-bottom: 8px; }
.calendar__head-icon { width: 40px; height: 40px; margin-right: 8px; }
.calendar__caption { font-size: 22px; -unity-font-style: bold; margin-right: 8px; }
.app .calendar__caption { color: var(--chrome-dim); }
.app .calendar__caption--strong { color: var(--on-chrome); }
.calendar__tokens { flex-direction: column; margin-left: 14px; }
.calendar__token { width: 22px; height: 22px; margin: 3px 0; border-radius: 11px; background-color: var(--accent); border-width: 3px; border-color: var(--accent); }
.calendar__token--spent { background-color: rgba(0, 0, 0, 0); border-color: var(--chrome-dim); }
.calendar__row { flex-direction: row; }
.calendar__cell { flex-grow: 1; flex-basis: 0; margin: 0 4px; padding: 6px 12px 8px 12px; border-radius: 24px; border-width: 0; border-bottom-width: 5px; border-bottom-color: var(--chrome-lip); background-color: var(--chrome-2); align-items: flex-start; }
.calendar__cell:first-child { margin-left: 0; }
.calendar__cell:last-child { margin-right: 0; }
.calendar__cell-head { font-size: 19px; -unity-font-style: bold; }
.calendar__cell-name { font-size: 22px; -unity-font-style: bold; }
.calendar__cell-amount { font-size: 22px; -unity-font-style: bold; }
.app .calendar__cell-head, .app .calendar__cell-amount { color: var(--chrome-dim); }
.app .calendar__cell-name { color: var(--on-chrome); }
.app .calendar__cell--ok .calendar__cell-amount { color: var(--money-on-chrome); }
.app .calendar__cell--gap .calendar__cell-amount { color: #FF9A8F; }
.calendar__cell--gap { border-bottom-color: var(--negative); }
.calendar__cell--past { opacity: 0.6; }
.calendar__cell--now { background-color: var(--card-face); border-width: 3px; border-color: var(--accent); border-bottom-width: 6px; border-bottom-color: var(--accent-lip); }
.app .calendar__cell--now .calendar__cell-name { color: var(--text); }
.app .calendar__cell--now .calendar__cell-head { color: var(--text-dim); }
.app .calendar__cell--now.calendar__cell--ok .calendar__cell-amount { color: var(--money); }
.app .calendar__cell--now.calendar__cell--gap .calendar__cell-amount { color: var(--negative); }
.app Button.calendar__cell:hover, .app Button.calendar__cell:focus { background-color: var(--chrome-2); }
.app Button.calendar__cell.calendar__cell--now:hover, .app Button.calendar__cell.calendar__cell--now:focus { background-color: var(--card-face); }
.npc-tag-box { position: absolute; translate: -50% -100%; align-items: center; }
.npc-tag-box .npc-tag { position: relative; translate: 0 0; }

/* ===== Stage 5B step 3 · conversations ===== */
.dialogue__options-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.dialogue .dialogue__option { width: 49%; min-height: 150px; margin: 8px 0; padding: 18px 18px 14px 18px; border-radius: 28px; border-width: 3px; border-color: var(--card-edge); border-bottom-width: 9px; border-bottom-color: var(--card-lip); background-color: var(--card-face); align-items: flex-start; }
.dialogue__option-text { font-size: 30px; white-space: normal; -unity-text-align: upper-left; margin-top: 54px; }
.dialogue .dialogue__option-text { color: var(--text); }
.dialogue__tone-icon { position: absolute; left: 14px; top: 10px; width: 56px; height: 56px; }
.dialogue__tone { position: absolute; left: 78px; top: 22px; font-size: 22px; -unity-font-style: bold; }
.dialogue .dialogue__tone { color: var(--text-dim); }
.dialogue__option--friendly { border-color: #7BC795; }
.dialogue__option--business { border-color: #8FA3D6; }
.dialogue__option--joke { border-color: #F2C14E; }
.dialogue__option--firm { border-color: #E58A7F; }
.dialogue__option-chips { flex-direction: row; flex-wrap: wrap; margin-top: 8px; }
.dialogue__requires { flex-direction: row; align-items: center; margin-top: 8px; padding: 4px 14px; border-radius: 18px; background-color: #EFEAFF; }
.dialogue__lock { width: 28px; height: 28px; margin-right: 6px; -unity-background-image-tint-color: #4B30C2; }
.dialogue__requires-text { font-size: 24px; -unity-font-style: bold; margin-right: 6px; }
.dialogue .dialogue__requires-text { color: #4B30C2; }
.dialogue .dialogue__option--locked:disabled { opacity: 0.85; background-color: #F4F1FB; border-color: #B9A9E8; border-bottom-color: #B9A9E8; }
.dialogue Button.dialogue__option:hover, .dialogue Button.dialogue__option:focus { background-color: var(--card-face); }
.dialogue__nameplate { flex-direction: row; align-items: center; }
.dialogue__hearts { flex-direction: row; align-items: center; margin-left: 12px; padding: 2px 12px; border-radius: 16px; background-color: var(--tile); }
.dialogue__heart-icon { width: 34px; height: 34px; margin-right: 4px; }
.dialogue__hearts-value { font-size: 26px; -unity-font-style: bold; }
.dialogue .dialogue__hearts-value { color: var(--text); }
.trust-float { position: absolute; right: 30px; top: -70px; flex-direction: row; align-items: center; padding: 6px 18px; border-radius: 24px; background-color: var(--positive); transition-property: translate, opacity; transition-duration: 1s, 0.5s; transition-delay: 0s, 0.5s; }
.trust-float--down { background-color: var(--negative); }
.trust-float--fly { translate: 0 -60px; opacity: 0; }
.trust-float Label { font-size: 30px; -unity-font-style: bold; color: #FFFFFF; }
.trust-float .game-icon { width: 40px; height: 40px; margin-left: 6px; }

/* The host's hearts in a room. */
.visit__hearts { flex-direction: row; align-items: center; margin-top: 4px; }
.visit__heart-icon { width: 34px; height: 34px; margin-right: 4px; }
.visit__hearts-value { font-size: 26px; -unity-font-style: bold; }

/* A relationship level reached: flash, banner, bonus (1.5 s, a tap skips). */
.level-up { position: absolute; left: -4000px; right: -4000px; top: 0; bottom: 0; border-left-width: 4000px; border-right-width: 4000px; border-color: rgba(0, 0, 0, 0); justify-content: center; align-items: center; background-color: rgba(10, 12, 20, 0.35); }
.level-up__flash { position: absolute; left: -4000px; right: -4000px; top: 0; bottom: 0; background-color: rgba(255, 245, 210, 0.9); opacity: 1; transition-property: opacity; transition-duration: 0.35s; }
.level-up--in .level-up__flash { opacity: 0; }
.level-up__banner { width: 900px; padding: 30px 36px; border-radius: 48px; background-color: var(--chrome); border-width: 4px; border-color: var(--accent); border-bottom-width: 12px; border-bottom-color: var(--accent-lip); align-items: center; scale: 0.6 0.6; opacity: 0; transition-property: scale, opacity; transition-duration: 0.3s, 0.2s; transition-timing-function: ease-out-back, ease-out; }
.level-up--in .level-up__banner { scale: 1 1; opacity: 1; }
.level-up__icon { width: 150px; height: 150px; margin-top: -100px; }
.level-up__title { flex-direction: row; align-items: center; margin-top: 8px; }
.level-up__name, .level-up__word, .level-up__level { font-size: 52px; -unity-font-style: bold; margin: 0 8px; }
.app .level-up__name, .app .level-up__word { color: var(--on-chrome); }
.app .level-up__level { color: var(--accent); }
.level-up__bonus-row { flex-direction: row; align-items: center; margin-top: 16px; padding: 12px 20px; border-radius: 28px; background-color: var(--chrome-2); }
.level-up__bonus-icon { width: 72px; height: 72px; margin-right: 12px; }
.level-up__bonus { font-size: 32px; -unity-font-style: bold; white-space: normal; flex-shrink: 1; }
.app .level-up__bonus { color: var(--on-chrome); }
.scene-open .visit { display: none; }

/* ===== Stage 5B step 4 · needs, moods, wants ===== */
.need-fill--relationships { background-color: #FF8FA8; }
.need-fill--knowledge { background-color: #B9A4FF; }
.need-fill--reputation { background-color: #FFD27A; }
.hud__stat--low .energy-bar { border-width: 2px; border-color: #FF9A8F; }
.hud__stat { margin-bottom: 6px; }
.needs__row { flex-direction: row; align-items: flex-start; padding: 12px 0; border-bottom-width: 1px; border-bottom-color: var(--track); }
.needs__icon { width: 80px; height: 80px; margin-right: 16px; }
.needs__text { flex-grow: 1; flex-shrink: 1; }
.needs__name { font-size: 34px; -unity-font-style: bold; }
.needs__line { font-size: 26px; white-space: normal; margin-top: 4px; }
.app .needs__line--down { color: var(--negative); }
.moods { flex-direction: row; flex-wrap: wrap; margin-bottom: -4px; }
.mood { flex-direction: row; align-items: center; height: 60px; margin: 0 8px 8px 0; padding: 0 16px 0 6px; border-radius: 30px; border-width: 2px; border-color: var(--card-edge); border-bottom-width: 5px; border-bottom-color: var(--card-lip); background-color: var(--card-face); }
.mood__icon { width: 48px; height: 48px; margin-right: 6px; }
.mood__name { font-size: 22px; -unity-font-style: bold; }
.mood__sign { font-size: 26px; -unity-font-style: bold; margin-left: 6px; }
.app .mood--good .mood__sign { color: var(--positive); }
.app .mood--bad .mood__sign { color: var(--negative); }
.app Button.mood:hover, .app Button.mood:focus { background-color: var(--card-face); }
.wants { margin-top: 12px; padding: 8px 20px; border-radius: 28px; background-color: var(--card-face); border-width: 2px; border-color: var(--card-edge); border-top-color: var(--card-highlight); border-bottom-width: 7px; border-bottom-color: var(--card-lip); }
.wants__head { flex-direction: row; align-items: center; margin: 0; padding: 4px 0; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.app Button.wants__head:hover, .app Button.wants__head:focus, .app Button.wants__head:active { background-color: rgba(0, 0, 0, 0); }
.wants__icon { width: 50px; height: 50px; margin-right: 10px; }
.wants__title { flex-grow: 1; font-size: 30px; -unity-font-style: bold; -unity-text-align: middle-left; }
.wants__count { padding: 2px 14px; border-radius: 18px; background-color: var(--track); font-size: 26px; -unity-font-style: bold; }
.want { flex-direction: row; align-items: center; padding: 8px 0; }
.want__box { width: 44px; height: 44px; margin-right: 12px; border-radius: 12px; border-width: 3px; border-color: var(--card-lip); align-items: center; justify-content: center; }
.want--done .want__box { background-color: var(--positive); border-color: var(--positive); }
.want__check { width: 30px; height: 30px; -unity-background-image-tint-color: #FFFFFF; }
.want__icon { width: 46px; height: 46px; margin-right: 10px; }
.want__text { flex-grow: 1; flex-shrink: 1; font-size: 28px; white-space: normal; }
.want__arg { font-size: 28px; -unity-font-style: bold; margin-left: 6px; }
.app .want--done .want__text { color: var(--text-dim); }

/* ===== Stage 6 · touch targets ≥ 44 pt (127 panel px at 1080 wide on the narrowest, 375-pt iPhone) ===== */
.icon-button { height: 128px; }
.calendar__cell { min-height: 128px; justify-content: center; }
.gate__item { height: 128px; }
.guide__action { height: 128px; }
.visit__talk, .visit__exit { height: 128px; }
.week-card--small { min-height: 128px; justify-content: center; }
.wants__head { min-height: 128px; }
.camera-button { width: 128px; height: 128px; border-radius: 64px; }
#city-home { min-width: 128px; }
.popup-close { height: 128px; border-radius: 64px; }
.moods { justify-content: space-between; }
.mood { flex-direction: column; justify-content: center; width: 24%; height: 128px; margin: 0 0 8px 0; padding: 6px 6px; border-radius: 28px; }
.mood__icon { width: 52px; height: 52px; margin: 0 0 2px 0; }
.mood__name { font-size: 19px; white-space: normal; -unity-text-align: middle-center; }
.mood__sign { position: absolute; right: 12px; top: 6px; margin: 0; }

/* ===== §8 · the top must not hide the city: a thin bar by default, the full panel on a tap ===== */
.hud { margin: 10px 16px 0 16px; padding: 6px 12px 8px 14px; border-radius: 40px; }
.hud__bar { flex-direction: row; align-items: center; height: 128px; }
.hud__bar .hud__pill { height: 112px; padding: 0 16px 0 6px; margin-right: 8px; flex-shrink: 1; }
.hud__bar .hud__pill-icon { width: 56px; height: 56px; margin-right: 6px; }
.hud__bar .hud__caption { font-size: 20px; }
.hud__bar .hud__value { font-size: 38px; }
.hud__rings { flex-direction: row; align-items: center; flex-shrink: 0; }
.need-ring { width: 84px; height: 84px; margin: 0 4px; justify-content: center; align-items: center; border-radius: 42px; transition-property: scale; transition-duration: 0.45s; transition-timing-function: ease-in-out; }
.need-ring__icon { width: 46px; height: 46px; }
.hud__menu { width: 128px; height: 128px; margin: 0; padding: 0; border-radius: 64px; border-width: 0; background-color: var(--chrome-2); justify-content: center; align-items: center; font-size: 1px; }
.hud__menu .icon { width: 60px; height: 60px; margin: 0; -unity-background-image-tint-color: var(--on-chrome); }
.hud__bar .chapter-bar__advance { height: 112px; margin: 0 8px 0 0; padding: 0 18px; border-radius: 56px; font-size: 24px; flex-shrink: 1; }
.hud__goal { height: 8px; margin: 4px 12px 0 12px; border-radius: 4px; background-color: var(--chrome-2); overflow: hidden; transition-property: opacity; transition-duration: 0.3s; }
.hud__goal-fill { height: 100%; width: 0; border-radius: 4px; background-color: var(--accent); }
/* Danger never hides: a low need's ring and a money week pulse (HudView flips hud--beat). */
.need-ring.hud--alarm { background-color: rgba(255, 110, 96, 0.35); }
.hud__pill.hud--alarm { background-color: rgba(255, 110, 96, 0.35); transition-property: scale; transition-duration: 0.45s; transition-timing-function: ease-in-out; }
.hud--beat .hud--alarm { scale: 1.12 1.12; }
/* The open panel drops under the bar with a bounce, over the city instead of pushing it. */
.hud__expanded { position: absolute; left: 0; right: 0; top: 100%; margin-top: 8px; padding: 14px 18px 18px 18px; border-radius: 40px; border-width: 2px; border-color: var(--chrome-edge); background-color: var(--chrome); translate: 0 -40px; opacity: 0; transition-property: translate, opacity; transition-duration: 0.25s, 0.16s; transition-timing-function: ease-out-back, ease-out; }
.hud__expanded.popup--in { translate: 0 0; opacity: 1; }
.hud__expanded-row { flex-direction: row; justify-content: flex-end; }
.hud__expanded .chapter-bar { margin: 8px 0 0 0; }
.hud--expanded .hud__goal { opacity: 0; }
/* Walk mode: while the camera or the hero moves, only the bar and the dock stay. */
.city-stack, .camera-buttons, .hero-tag, .place-marker { transition-property: opacity; transition-duration: 0.3s; }
.city-moving .city-stack, .city-moving .hud__goal, .city-moving .place-marker { opacity: 0; }
/* The camera's buttons: one compact row at the right edge, just under the bar. */
.camera-buttons { top: 16px; right: 16px; }
.camera-button { margin-left: 8px; font-size: 40px; }
#city-home { padding: 0 22px; font-size: 24px; }
/* Places open as a sheet from the bottom, the street still showing above it. */
.screen--sheet { top: 22%; left: 0; right: 0; bottom: 0; background-color: var(--ground); border-top-left-radius: 44px; border-top-right-radius: 44px; border-width: 2px 2px 0 2px; border-color: var(--card-edge); }
/* The open panel lies over the city: the camera buttons, the cards and the signs wait under it. */
.hud-open .camera-buttons, .hud-open .city-stack, .hud-open .place-marker, .hud-open .hero-tag { display: none; }
/* Hidden cards take no taps while the player walks. */
.city-moving .city-stack, .city-moving .place-marker { visibility: hidden; }
